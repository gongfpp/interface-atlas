---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/islands/SearchDialog';
import { type Locale, localePath, withBase } from '@/lib/i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** 英文版对应路径，用于 hreflang；无则视为无镜像 */
  enPath?: string;
  /** 落地即打开命令面板（/search 页用；避免依赖事件派发时机） */
  autoOpenSearch?: boolean;
}

const { title, description, locale, enPath, autoOpenSearch = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const themeScript = `
(function(){
  try {
    var stored = localStorage.getItem('ia-theme');
    var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (dark) document.documentElement.classList.add('dark');
  } catch (e) {}
})();
`;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-analytics-preview={import.meta.env.PUBLIC_PREVIEW === 'true' ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_PREVIEW === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {enPath && <link rel="alternate" hreflang="zh" href={new URL(localePath(enPath, 'zh'), Astro.site)} />}
    {enPath && <link rel="alternate" hreflang="en" href={new URL(localePath(enPath, 'en'), Astro.site)} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline set:html={themeScript} />
    {/* Umami 埋点（PRD §27a）：PUBLIC_UMAMI_SRC + PUBLIC_UMAMI_ID 配置后启用 */}
    {import.meta.env.PUBLIC_PREVIEW !== 'true' && import.meta.env.PUBLIC_UMAMI_SRC && import.meta.env.PUBLIC_UMAMI_ID && (
      <script is:inline defer src={import.meta.env.PUBLIC_UMAMI_SRC} data-website-id={import.meta.env.PUBLIC_UMAMI_ID}
        data-exclude-search="true" data-exclude-hash="true" data-do-not-track="true" data-performance="true"
        onload="window.dispatchEvent(new Event('ia:analytics-ready'))"></script>
    )}
    {/* Cloudflare Web Analytics（无 cookie 访客统计）：PUBLIC_CF_BEACON_TOKEN 配置后启用 */}
    {import.meta.env.PUBLIC_PREVIEW !== 'true' && import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON_TOKEN })}
      ></script>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="界面图谱 · Interface Atlas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-raised focus:px-3 focus:py-2">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl px-5 md:px-8">
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchDialog client:idle locale={locale} autoOpen={autoOpenSearch} />
    <script>
      import { startAnalytics } from '@/lib/analytics';
      startAnalytics();
    </script>
  </body>
</html>
