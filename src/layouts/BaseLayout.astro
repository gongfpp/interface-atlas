---
import '@/styles/global.css';
import '@/styles/interaction-motion.css';
import '@/styles/page-motion.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/islands/SearchDialog';
import { type Locale, localePath, withBase } from '@/lib/i18n';
import { analyticsIdentityScript } from '@/lib/analytics-identity';
import { analyticsScriptConfig } from '@/lib/analytics-config';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** 英文版对应路径，用于 hreflang；无则视为无镜像 */
  enPath?: string;
  /** 落地即打开命令面板（/search 页用；避免依赖事件派发时机） */
  autoOpenSearch?: boolean;
  /** 完整交互视口不应被外层吸顶导航覆盖；其它页面保持默认。 */
  stickyHeader?: boolean;
}

const { title, description, locale, enPath, autoOpenSearch = false, stickyHeader = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const analyticsConfig = analyticsScriptConfig({
  origin: Astro.site?.origin || Astro.url.origin,
  legacySrc: import.meta.env.PUBLIC_UMAMI_SRC,
  legacyId: import.meta.env.PUBLIC_UMAMI_ID,
  edgeOneSrc: import.meta.env.PUBLIC_EDGEONE_UMAMI_SRC,
  edgeOneId: import.meta.env.PUBLIC_EDGEONE_UMAMI_ID,
});

const themeScript = `
(function(){
  try {
    var stored = localStorage.getItem('ia-theme');
    var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (dark) document.documentElement.classList.add('dark');
  } catch (e) {}
})();
`;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-atlas-page data-analytics-preview={import.meta.env.PUBLIC_PREVIEW === 'true' ? 'true' : undefined} data-analytics-upgrade={analyticsConfig.upgraded ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_PREVIEW === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {enPath && <link rel="alternate" hreflang="zh" href={new URL(localePath(enPath, 'zh'), Astro.site)} />}
    {enPath && <link rel="alternate" hreflang="en" href={new URL(localePath(enPath, 'en'), Astro.site)} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline set:html={themeScript} />
    <script is:inline>
      // Resizing or quickly navigating again may legitimately skip a native transition.
      for (const name of ['pagereveal', 'pageswap']) addEventListener(name, event => {
        event.viewTransition?.ready.catch(() => {});
      });
    </script>
    {/* Umami 埋点（PRD §27a）：PUBLIC_UMAMI_SRC + PUBLIC_UMAMI_ID 配置后启用 */}
    {import.meta.env.PUBLIC_PREVIEW !== 'true' && analyticsConfig.upgraded && <script is:inline set:html={analyticsIdentityScript} />}
    {import.meta.env.PUBLIC_PREVIEW !== 'true' && analyticsConfig.upgraded && (
      <script is:inline>
        // 此钩子同时过滤自动 pageview、性能事件和自定义事件，不创建第二个 tracker。
        window.iaAnalyticsBeforeSend = function (_type, payload) {
          const forgetVisitor = () => {
            try { if (window.iaAnalyticsResetVisitor) { window.iaAnalyticsResetVisitor(); return; } } catch { /* 回退到同一固定访客键 */ }
            try { localStorage.removeItem('ia:analytics:visitor:v1'); } catch { /* 存储受限不影响页面 */ }
          };
          try {
            const allowedOrigin = window.location.origin === 'https://atlas.gongfpp.icu' && document.documentElement.dataset.analyticsUpgrade === 'true'
              || window.location.origin === 'https://stats.gongfpp.icu' && document.documentElement.dataset.analyticsQa === 'true'
                && window.location.pathname.startsWith('/_qa/analytics-20261027/');
            if (!allowedOrigin || document.documentElement.dataset.analyticsPreview === 'true'
            || navigator.globalPrivacyControl === true
            || [navigator.doNotTrack, window.doNotTrack, navigator.msDoNotTrack].some(value => value === '1' || value === 'yes' || value === 1)) { forgetVisitor(); return null; } } catch { forgetVisitor(); return null; }
          try { if (localStorage.getItem('umami.disabled') === '1') { forgetVisitor(); return null; } } catch { /* 存储受限不影响页面 */ }
          const visitor = window.iaAnalyticsVisitor?.();
          const next = { ...payload };
          delete next.id;
          if (visitor) next.id = visitor.id;
          if (payload?.data?.schema === 2) {
            next.data = { ...payload.data };
            delete next.data.visitor_id;
            delete next.data.visitor_born_at;
            // 到期边界的晚加载旧事件仍可匿名送达，不把旧事件挂到后来出生的新身份。
            if (visitor && next.data.event_time >= visitor.bornAt && next.data.event_time - visitor.bornAt < 90 * 86400000) {
              next.data.visitor_id = visitor.id;
              next.data.visitor_born_at = visitor.bornAt;
            } else delete next.id;
          }
          return next;
        };
      </script>
    )}
    {import.meta.env.PUBLIC_PREVIEW !== 'true' && analyticsConfig.src && analyticsConfig.id && (
      <script is:inline defer src={analyticsConfig.src} data-website-id={analyticsConfig.id}
        data-before-send={analyticsConfig.upgraded ? 'iaAnalyticsBeforeSend' : undefined} data-domains={analyticsConfig.domains}
        data-exclude-search="true" data-exclude-hash="true" data-do-not-track="true" data-performance="true"
        onload="window.dispatchEvent(new Event('ia:analytics-ready'))"></script>
    )}
    {/* Cloudflare Web Analytics（无 cookie 访客统计）：PUBLIC_CF_BEACON_TOKEN 配置后启用 */}
    {import.meta.env.PUBLIC_PREVIEW !== 'true' && import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON_TOKEN })}
      ></script>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="界面图谱 · Interface Atlas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-raised focus:px-3 focus:py-2">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <Header locale={locale} sticky={stickyHeader} />
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl px-5 md:px-8">
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchDialog client:idle locale={locale} autoOpen={autoOpenSearch} />
    <script>
      import { startAnalytics } from '@/lib/analytics';
      import { initInteractionMotion, initPageMotion } from '@/lib/interaction-motion';
      startAnalytics();
      initInteractionMotion();
      initPageMotion();
    </script>
  </body>
</html>
