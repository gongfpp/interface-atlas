---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localePath } from '@/lib/i18n';
---

<BaseLayout title="404 · 界面图谱" description="页面不存在" locale="zh" enPath="/">
  <section class="py-32 text-center">
    <p class="font-serif text-6xl font-semibold text-ink-3">404</p>
    <p class="mt-4 text-ink-2">这个概念还不存在——或者它本来就不该被这样使用。</p>
    <a href={localePath('/', 'zh')} class="mt-6 inline-block rounded-full border border-line px-5 py-2 text-sm hover:border-accent hover:text-accent">回到首页</a>
  </section>
</BaseLayout>
