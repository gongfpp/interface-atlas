---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SavedView from '@/islands/SavedView';
import { getAllConcepts } from '@/lib/content';

const concepts = (await getAllConcepts()).map((c) => ({
  id: c.id,
  type: c.conceptType,
  name: c.data.name,
}));
---

<BaseLayout
  title="My notebook · Interface Atlas"
  description="Save interface solutions, organize project groups, record your reasons, and export Markdown."
  locale="en"
  enPath="/saved"
>
  <section class="pt-14 pb-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">My notebook</h1>
    <p class="mt-3 max-w-2xl text-ink-2">Bring a chosen solution into your project. Your notebook, saved concepts, and history stay in this browser. Clearing browser data deletes them; export important solutions as a backup.</p>
  </section>
  <SavedView client:load concepts={concepts} locale="en" />
</BaseLayout>
