---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localePath, withBase } from '@/lib/i18n';
---

<BaseLayout title="Gallery · Interface Atlas" description="AI-generated component reference sheets, each with a reproducible image-generation prompt." locale="en">
  <section class="pt-14 pb-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">Gallery</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      AI-generated component reference sheets — every set ships with a copyable
      image-generation prompt so you can produce the same style of sheets for your own themes.
    </p>
  </section>
  <div class="grid gap-5 pb-20 sm:grid-cols-2 md:grid-cols-3">
    {(await getCollection('gallery'))
      .filter((e) => e.data.status === 'published')
      .sort((a, b) => a.id.localeCompare(b.id))
      .map((entry) => (
        <a
          href={localePath(`/gallery/${entry.id}`, 'en')}
          class="group overflow-hidden rounded-xl border border-line bg-raised transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-sm"
        >
          <img
            src={withBase(entry.data.images[0]?.file ?? '')}
            alt={entry.data.name.en}
            loading="lazy"
            width="1600"
            height="2000"
            class="aspect-[4/5] w-full object-cover object-top"
          />
          <div class="p-4">
            <p class="font-serif font-semibold group-hover:text-accent">{entry.data.name.en}</p>
            <p class="text-xs text-ink-3">{entry.data.name.zh} · {entry.data.images.length} sheets</p>
          </div>
        </a>
      ))}
  </div>
</BaseLayout>
