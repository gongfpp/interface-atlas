---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GiscusComments from '@/components/GiscusComments.astro';
---

<BaseLayout
  title="Board · Interface Atlas"
  description="Leave a note, report a problem, or suggest a feature — all messages are public."
  locale="en"
  enPath="/board"
>
  <section class="pt-14 pb-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">Board</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      Missing a concept, spotted a mistake, or have a feature idea? Leave a note here. Messages are public; sign in with a GitHub account to join in. Data lives in this repository's GitHub Discussions, and you can also
      <a class="text-accent hover:underline" href="https://github.com/gongfpp/interface-atlas-web/discussions" rel="noopener">browse all discussions on GitHub</a>.
    </p>
  </section>
  <section class="pb-20">
    <GiscusComments locale="en" />
  </section>
</BaseLayout>
