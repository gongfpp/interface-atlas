---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCompareGroups } from '@/lib/compare';
import { TYPE_LABELS, localePath } from '@/lib/i18n';

const groups = await getCompareGroups();
---

<BaseLayout
  title="Concept comparisons · Interface Atlas"
  description="Compare easily-confused frontend design concepts side by side: Modal vs Drawer vs Popover, Skeleton vs Spinner vs Progress Bar, dimension by dimension."
  locale="en"
  enPath="/compare"
>
  <section class="pt-14 pb-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">Concept comparisons</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      Easily-confused concepts placed side by side, compared dimension by dimension — so you
      choose deliberately before you build.
    </p>
  </section>

  <div class="grid gap-4 pb-20 sm:grid-cols-2 md:grid-cols-3">
    {groups.map((g) => (
      <a
        href={localePath(`/compare/${g.group}`, 'en')}
        class="group flex flex-col rounded-xl border border-line bg-raised p-5 transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-sm"
      >
        <ul class="flex flex-1 flex-col gap-1.5">
          {g.members.map((m) => (
            <li class="flex items-baseline justify-between gap-2">
              <span class="font-serif font-semibold transition-colors group-hover:text-accent">
                {m.data.name.en}
              </span>
              <span class="text-xs text-ink-3">{TYPE_LABELS[m.conceptType].en}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-ink-3">
          {g.members.length} concepts · {g.dimensions.length} dimensions →
        </p>
      </a>
    ))}
  </div>
</BaseLayout>
