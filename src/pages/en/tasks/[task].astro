---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TaskGuideView from '@/components/TaskGuideView.astro';
import { TASK_GUIDES } from '@/lib/task-guides';
export function getStaticPaths() { return TASK_GUIDES.map(guide => ({ params: { task: guide.id }, props: { guide } })); }
const { guide } = Astro.props;
---
<BaseLayout title={`${guide.title.en} — Interface Atlas`} description={guide.intro.en} locale="en" enPath={`/tasks/${guide.id}`}><TaskGuideView guide={guide} locale="en" /></BaseLayout>
