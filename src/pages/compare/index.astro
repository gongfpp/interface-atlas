---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCompareGroups } from '@/lib/compare';
import { TYPE_LABELS, localePath } from '@/lib/i18n';

const groups = await getCompareGroups();
---

<BaseLayout
  title="概念对比 · 界面图谱"
  description="把容易混淆的前端设计概念并排对比：Modal / Drawer / Popover、Skeleton / Spinner / Progress Bar 等，按维度逐项看清差异。"
  locale="zh"
  enPath="/compare"
>
  <section class="pt-14 pb-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">概念对比</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      把容易混淆的概念并排放在一起，按维度逐项对比——帮你在动手前做对选择，而不是凭感觉。
    </p>
  </section>

  <div class="grid gap-4 pb-20 sm:grid-cols-2 md:grid-cols-3">
    {groups.map((g) => (
      <a
        href={localePath(`/compare/${g.group}`, 'zh')}
        class="group flex flex-col rounded-xl border border-line bg-raised p-5 transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-sm"
      >
        <ul class="flex flex-1 flex-col gap-1.5">
          {g.members.map((m) => (
            <li class="flex items-baseline justify-between gap-2">
              <span class="font-serif font-semibold transition-colors group-hover:text-accent">
                {m.data.name.zh}
              </span>
              <span class="text-xs text-ink-3">{TYPE_LABELS[m.conceptType].zh}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-ink-3">
          {g.members.length} 个概念 · {g.dimensions.length} 个维度 →
        </p>
      </a>
    ))}
  </div>
</BaseLayout>
