---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CompareTable from '@/components/CompareTable.astro';
import { getCompareGroups, type CompareGroup } from '@/lib/compare';
import { localePath } from '@/lib/i18n';

export async function getStaticPaths() {
  const groups = await getCompareGroups();
  return groups.map((group) => ({ params: { group: group.group }, props: { group } }));
}

interface Props {
  group: CompareGroup;
}
const { group } = Astro.props;
const names = group.members.map((m) => m.data.name.zh).join(' · ');
const namesEn = group.members.map((m) => m.data.name.en).join(' · ');
---

<BaseLayout
  title={`${names} 对比 · 界面图谱`}
  description={`并排对比 ${names}（${namesEn}）：按 ${group.dimensions.length} 个维度逐项查看差异，点击表头进入概念详情。`}
  locale="zh"
  enPath={`/compare/${group.group}`}
>
  <article class="pt-10">
    <a href={localePath('/compare', 'zh')} class="text-xs uppercase tracking-[0.2em] text-accent">概念对比</a>
    <h1 class="mt-3 font-serif text-3xl font-semibold md:text-4xl">{names}</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      并排对比 {group.members.length} 个概念，按 {group.dimensions.length} 个维度逐项查看差异。点击表头进入对应概念详情。
    </p>
    <div class="mt-8 pb-20">
      <CompareTable concepts={group.members} locale="zh" />
    </div>
  </article>
</BaseLayout>
