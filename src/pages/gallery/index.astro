---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localePath, withBase } from '@/lib/i18n';
---

<BaseLayout title="灵感图库 · 界面图谱" description="AI 生成的组件设计参考图集，每套图附可复现的生图 Prompt。" locale="zh" enPath="/gallery">
  <section class="pt-14 pb-8">
    <h1 class="font-serif text-3xl font-semibold md:text-4xl">灵感图库</h1>
    <p class="mt-3 max-w-2xl text-ink-2">
      AI 生成的组件设计参考图集——每套图配一条可直接复制的生图 Prompt，换成你的主题就能产出同一风格的系列参考。
    </p>
  </section>
  <div class="grid gap-5 pb-20 sm:grid-cols-2 md:grid-cols-3">
    {(await getCollection('gallery'))
      .filter((e) => e.data.status === 'published')
      .sort((a, b) => a.id.localeCompare(b.id))
      .map((entry) => (
        <a
          href={localePath(`/gallery/${entry.id}`, 'zh')}
          class="group overflow-hidden rounded-xl border border-line bg-raised transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-sm"
        >
          <img
            src={withBase(entry.data.images[0]?.file ?? '')}
            alt={entry.data.name.zh}
            loading="lazy"
            width="1600"
            height="2000"
            class="aspect-[4/5] w-full object-cover object-top"
          />
          <div class="p-4">
            <p class="font-serif font-semibold group-hover:text-accent">{entry.data.name.zh}</p>
            <p class="text-xs text-ink-3">{entry.data.name.en} · {entry.data.images.length} 张</p>
          </div>
        </a>
      ))}
  </div>
</BaseLayout>
