---
import { galleryBreakdowns } from '@/lib/gallery-breakdowns';
import { localePath, withBase, type Locale } from '@/lib/i18n';
interface Props { id: string; locale: Locale }
const { id, locale } = Astro.props;
const data = galleryBreakdowns[id];
const zh = locale === 'zh';
const prefix = `breakdown-${id}`;
---
{data && <section class="gallery-breakdown py-10" data-gallery-breakdown aria-labelledby={`${prefix}-title`}>
  <p class="mb-2 text-xs uppercase tracking-[0.16em] text-accent">{zh ? '看见 → 理解 → 借用' : 'Observe → understand → borrow'}</p>
  <h2 id={`${prefix}-title`} class="font-serif text-2xl font-semibold">{data.title[locale]}</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-2">{zh ? '点编号，查看原图中的具体位置与局部细节。它是 AI 生成的静态参考图；以下区分图中可见的结构和实现时需要补齐的行为。' : 'Choose a number to locate a detail in the original image. This is an AI-generated static reference; the notes distinguish visible structure from behavior that still needs implementation.'}</p>
  <div class="breakdown-layout mt-6">
    <figure class="min-w-0">
      <div class="breakdown-figure">
        <img src={withBase(data.image)} alt={data.alt[locale]} width={data.width} height={data.height} loading="lazy" class="block w-full rounded-lg border border-line" />
        {data.annotations.map((annotation, index) => <>
          <button type="button" class="breakdown-marker" style={`top:${annotation.region.y + annotation.region.height / 2}%`} data-annotation-button={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`${prefix}-panel-${index}`} aria-label={`${zh ? '标注' : 'Annotation'} ${index + 1}: ${annotation.title[locale]}`}>{index + 1}</button>
          <span class="breakdown-region" data-annotation-region={index} hidden={index !== 0} aria-hidden="true" style={`left:${annotation.region.x}%;top:${annotation.region.y}%;width:${annotation.region.width}%;height:${annotation.region.height}%`} />
        </>)}
      </div>
      <figcaption class="mt-3 pl-10 text-xs leading-relaxed text-ink-3">{zh ? '原图：基础视觉结构 · 标注 1 / 2 / 3 对应原图第 01 / 04 / 05 行。' : 'Original: Form & structure. Annotations 1 / 2 / 3 refer to original rows 01 / 04 / 05.'} <a href={withBase(data.image)} target="_blank" rel="noopener noreferrer" class="text-accent underline">{zh ? '打开原图 ↗' : 'Open full image ↗'}</a></figcaption>
    </figure>
    <div class="min-w-0">
      <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label={zh ? '选择拆解标注' : 'Choose an annotation'}>
        {data.annotations.map((annotation, index) => <button type="button" class="breakdown-choice" data-annotation-button={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`${prefix}-panel-${index}`}>{index + 1} · {zh ? `原图 ${annotation.row}` : `Row ${annotation.row}`}</button>)}
      </div>
      <div aria-live="polite" aria-atomic="false">
        {data.annotations.map((annotation, index) => <article id={`${prefix}-panel-${index}`} data-annotation-panel={index} hidden={index !== 0} class="rounded-xl border border-line bg-raised p-5">
          <p class="mb-2 text-xs text-accent">{zh ? `标注 ${index + 1} · 原图第 ${annotation.row} 行` : `Annotation ${index + 1} · Original row ${annotation.row}`}</p>
          <h3 class="font-serif text-xl font-semibold">{annotation.title[locale]}</h3>
          <div class="breakdown-crop mt-4" role="img" aria-label={zh ? `原图第 ${annotation.row} 行局部放大` : `Enlarged detail of original row ${annotation.row}`} style={`aspect-ratio:${annotation.region.width * data.width}/${annotation.region.height * data.height}`}>
            <img aria-hidden="true" alt="" src={withBase(data.image)} width={data.width} height={data.height} loading="lazy" style={`width:${10000 / annotation.region.width}%;left:${-annotation.region.x / annotation.region.width * 100}%;top:${-annotation.region.y / annotation.region.height * 100}%`} />
          </div>
          <dl class="mt-5 space-y-4 text-sm leading-relaxed">
            <div><dt class="font-semibold">{zh ? '图中看见什么' : 'What is visible'}</dt><dd class="mt-1 text-ink-2">{annotation.observed[locale]}</dd></div>
            <div><dt class="font-semibold">{zh ? '可以借用什么' : 'What to borrow'}</dt><dd class="mt-1 text-ink-2">{annotation.borrow[locale]}</dd></div>
            <div><dt class="font-semibold">{zh ? '什么不应照搬' : 'What not to copy blindly'}</dt><dd class="mt-1 text-ink-2">{annotation.avoid[locale]}</dd></div>
          </dl>
        </article>)}
      </div>
      <p class="mt-4 text-xs leading-relaxed text-ink-3">{zh ? '实现依据：' : 'Implementation guidance: '}<a class="text-accent underline" href="https://www.w3.org/WAI/tutorials/forms/labels/">W3C WAI · {zh ? '表单标签' : 'Labeling controls'}</a> · <a class="text-accent underline" href="https://www.w3.org/WAI/tutorials/forms/instructions/">{zh ? '表单说明' : 'Form instructions'}</a></p>
      <a class="mt-4 inline-block text-sm text-accent underline" href={localePath('/components/input#playground', locale)}>{zh ? '到输入框实验室验证真实交互 →' : 'Try real interactions in the input lab →'}</a>
    </div>
  </div>
</section>}

<style>
  .breakdown-layout { display: grid; gap: 2rem; }
  .breakdown-figure { position: relative; margin-left: 40px; }
  .breakdown-marker { position: absolute; left: -44px; transform: translateY(-50%); width: 40px; height: 44px; border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-paper-raised); color: var(--color-ink); font: 600 14px var(--font-mono); }
  .breakdown-marker[aria-pressed="true"], .breakdown-choice[aria-pressed="true"] { background: var(--color-accent); color: white; border-color: var(--color-accent); }
  .breakdown-region { position: absolute; border: 2px solid var(--color-accent); border-radius: 7px; pointer-events: none; }
  .breakdown-choice { min-height: 44px; padding: 8px 14px; border: 1px solid var(--color-line); border-radius: 9px; font-size: 13px; }
  .breakdown-marker:focus-visible, .breakdown-choice:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .breakdown-crop { position: relative; overflow: hidden; border-radius: 8px; background: #faf9f5; }
  .breakdown-crop img { position: absolute; max-width: none; height: auto; }
  @media (min-width: 960px) { .breakdown-layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery-breakdown]').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('[data-annotation-button]').forEach((button) => {
      button.addEventListener('click', () => {
        const index = button.dataset.annotationButton;
        root.querySelectorAll<HTMLButtonElement>('[data-annotation-button]').forEach((choice) => choice.setAttribute('aria-pressed', String(choice.dataset.annotationButton === index)));
        root.querySelectorAll<HTMLElement>('[data-annotation-panel]').forEach((panel) => { panel.hidden = panel.dataset.annotationPanel !== index; });
        root.querySelectorAll<HTMLElement>('[data-annotation-region]').forEach((region) => { region.hidden = region.dataset.annotationRegion !== index; });
      });
    });
  });
</script>
