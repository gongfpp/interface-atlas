---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonMotionDemo from '@/islands/ButtonMotionDemo';
import ButtonMotionReferences from '@/components/ButtonMotionReferences.astro';
import { BUTTON_MOTIONS, MOTION_PAGE_SIZE, MOTION_PAGE_COUNT, buttonMotionPath } from '@/lib/button-motions';
import { localePath, type Locale } from '@/lib/i18n';
interface Props { page: number; locale: Locale }
const { page, locale } = Astro.props;
const zh = locale === 'zh';
const start = (page - 1) * MOTION_PAGE_SIZE;
const motions = BUTTON_MOTIONS.slice(start, start + MOTION_PAGE_SIZE);
const path = buttonMotionPath(page);
const title = zh ? '按钮动效' : 'Button Motion';
---
<BaseLayout title={`${title} · ${page} / ${MOTION_PAGE_COUNT} · ${zh ? '界面图谱' : 'Interface Atlas'}`} description={zh ? '40 种可交互的按钮动效，每行一种，每页 10 种。' : '40 interactive button effects. One effect per row, ten per page.'} locale={locale} enPath={path}>
  <section class="pt-12 pb-6">
    <a href={localePath('/motion', locale)} class="text-sm text-ink-3 hover:text-accent">← {zh ? '动效' : 'Motion'}</a>
    <div class="mt-5 flex flex-wrap items-end justify-between gap-5">
      <h1 class="font-serif text-4xl font-semibold">{title}</h1>
      <span class="text-sm text-ink-2">{zh ? '40 种效果' : '40 effects'}</span>
    </div>
  </section>
  <nav class="flex flex-wrap items-center justify-between gap-4 border-y border-line py-4" aria-label={zh ? '按钮动效分页' : 'Button motion pagination'}>
    <div class="flex flex-wrap gap-2">{Array.from({ length: MOTION_PAGE_COUNT }, (_, i) => <a class:list={['rounded-lg border px-4 py-2.5 text-sm transition-colors', page === i + 1 ? 'border-accent bg-accent text-white' : 'border-line hover:border-accent hover:text-accent']} aria-current={page === i + 1 ? 'page' : undefined} href={localePath(buttonMotionPath(i + 1), locale)}>{String(i * 10 + 1).padStart(2, '0')}–{(i + 1) * 10}</a>)}</div>
    <ButtonMotionReferences locale={locale} sheets={[(page - 1) * 2 + 1, page * 2]} />
  </nav>
  <div class="bm-catalogue py-2" data-motion-page={page}>
    {motions.map((motion, i) => <article id={motion.id} class="bm-row" data-motion-id={motion.id}>
      <div class="bm-meta">
        <p class="bm-number">{String(start + i + 1).padStart(2, '0')}</p>
        <h2><a href={`#${motion.id}`}>{motion.en}</a></h2>
        <p class="bm-cn">{motion.zh}</p>
        <div class="bm-meta-bottom">
          <ButtonMotionReferences locale={locale} sheets={[Math.floor((start + i) / 5) + 1]} compact />
          <span class="bm-duration">{motion.duration}ms</span>
        </div>
      </div>
      <ButtonMotionDemo motion={motion} locale={locale} client:load />
    </article>)}
  </div>
  <nav class="mb-12 mt-5 flex justify-between gap-3 border-t border-line pt-5 text-sm" aria-label={zh ? '前后页' : 'Previous and next page'}>
    {page > 1 ? <a class="rounded-lg border border-line px-4 py-3 hover:text-accent" rel="prev" href={localePath(buttonMotionPath(page - 1), locale)}>← {zh ? '上一页' : 'Previous'}</a> : <span />}
    {page < MOTION_PAGE_COUNT ? <a class="rounded-lg border border-line px-4 py-3 hover:text-accent" rel="next" href={localePath(buttonMotionPath(page + 1), locale)}>{zh ? '下一页' : 'Next'} →</a> : <a class="rounded-lg border border-line px-4 py-3 hover:text-accent" href={localePath(buttonMotionPath(), locale)}>{zh ? '回到第一页' : 'First page'} ↑</a>}
  </nav>
</BaseLayout>
