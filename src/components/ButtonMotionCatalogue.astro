---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonMotionDemo from '@/islands/ButtonMotionDemo';
import { BUTTON_MOTIONS, MOTION_PAGE_SIZE, MOTION_PAGE_COUNT, buttonMotionPath } from '@/lib/button-motions';
import { localePath, type Locale } from '@/lib/i18n';
interface Props { page: number; locale: Locale }
const { page, locale } = Astro.props;
const zh = locale === 'zh';
const start = (page - 1) * MOTION_PAGE_SIZE;
const motions = BUTTON_MOTIONS.slice(start, start + MOTION_PAGE_SIZE);
const path = buttonMotionPath(page);
const title = zh ? '按钮动效' : 'Button Motion';
---
<BaseLayout title={`${title} · ${page} / ${MOTION_PAGE_COUNT} · ${zh ? '界面图谱' : 'Interface Atlas'}`} description={zh ? '40 种可交互的按钮动效：参考 01–08，每行一种，每页 10 种。' : '40 interactive button effects from reference sheets 01–08. One effect per row, ten per page.'} locale={locale} enPath={path}>
  <section class="pt-12 pb-5">
    <a href={localePath('/motion', locale)} class="text-sm text-ink-3 hover:text-accent">← {zh ? '动效概念' : 'Motion concepts'}</a>
    <div class="mt-5 flex flex-wrap items-end justify-between gap-5">
      <div><p class="text-xs tracking-[.2em] text-ink-3">BUTTON MOTION DESIGN REFERENCE</p><h1 class="mt-3 font-serif text-4xl font-semibold">{title}</h1></div>
      <span class="text-sm text-ink-2">{zh ? '40 种效果 · 每页 10 种' : '40 effects · 10 per page'}</span>
    </div>
    <p class="mt-5 max-w-3xl text-sm leading-7 text-ink-2">{zh ? '不是按钮皮肤，而是可以亲手触发的反馈。按参考 01–08 排序，每行一种；试试悬停、点击、长按或拖动，也可以用键盘操作。加载、上传、删除与订阅均为演示，不发送数据、不执行真实删除。' : 'Not just button skins: feedback you can trigger. Ordered by sheets 01–08, one effect per row. Hover, click, hold or drag; keyboard interaction is supported. Loading, uploads, deletion and subscriptions are simulations: no data is sent or deleted.'}</p>
    <p class="mt-2 text-xs text-ink-3">{zh ? '系统开启“减少动态效果”时，保留状态反馈并减少位移动画。' : 'Reduced-motion preferences preserve state feedback while reducing movement.'}</p>
  </section>
  <nav class="flex flex-wrap items-center gap-2 border-y border-line py-4" aria-label={zh ? '按钮动效分页' : 'Button motion pagination'}>
    {Array.from({ length: MOTION_PAGE_COUNT }, (_, i) => <a class:list={['rounded-lg border px-4 py-2.5 text-sm transition-colors', page === i + 1 ? 'border-accent bg-accent text-white' : 'border-line hover:border-accent hover:text-accent']} aria-current={page === i + 1 ? 'page' : undefined} href={localePath(buttonMotionPath(i + 1), locale)}>{String(i * 10 + 1).padStart(2, '0')}–{(i + 1) * 10}</a>)}
    <span class="ml-auto text-xs text-ink-3">{zh ? `参考 ${String((page - 1) * 2 + 1).padStart(2, '0')}–${String(page * 2).padStart(2, '0')}` : `Sheets ${String((page - 1) * 2 + 1).padStart(2, '0')}–${String(page * 2).padStart(2, '0')}`}</span>
  </nav>
  <div class="bm-catalogue py-2" data-motion-page={page}>
    {motions.map((motion, i) => <article id={motion.id} class="bm-row" data-motion-id={motion.id}>
      <div class="bm-meta">
        <p class="bm-number">{String(start + i + 1).padStart(2, '0')}</p>
        <h2><a href={`#${motion.id}`}>{motion.en}</a></h2>
        <p class="bm-cn">{motion.zh}</p>
        <p class="bm-reference">{zh ? '参考' : 'SHEET'} {String(Math.floor((start + i) / 5) + 1).padStart(2, '0')} / {String((start + i) % 5 + 1).padStart(2, '0')}</p>
        <p class="bm-params">{motion.duration}ms<br />{motion.params}</p>
      </div>
      <ButtonMotionDemo motion={motion} locale={locale} client:load />
    </article>)}
  </div>
  <nav class="mb-12 mt-5 flex justify-between gap-3 border-t border-line pt-5 text-sm" aria-label={zh ? '前后页' : 'Previous and next page'}>
    {page > 1 ? <a class="rounded-lg border border-line px-4 py-3 hover:text-accent" rel="prev" href={localePath(buttonMotionPath(page - 1), locale)}>← {zh ? '上一页' : 'Previous'}</a> : <span />}
    {page < MOTION_PAGE_COUNT ? <a class="rounded-lg border border-line px-4 py-3 hover:text-accent" rel="next" href={localePath(buttonMotionPath(page + 1), locale)}>{zh ? '下一页' : 'Next'} →</a> : <a class="rounded-lg border border-line px-4 py-3 hover:text-accent" href={localePath(buttonMotionPath(), locale)}>{zh ? '回到第一组' : 'Back to first group'} ↑</a>}
  </nav>
  <details class="mb-14 text-xs leading-7 text-ink-3"><summary class="cursor-pointer">{zh ? '参考来源与实现说明' : 'References & implementation notes'}</summary>
    <p>{zh ? '根据静态参考图重建可运行交互；图中没有给出逐帧视频，因此节奏和曲线按标注与交互语义实现，并非原作者的源代码。' : 'Working interactions reconstructed from static reference diagrams, using their timings and interaction semantics; not the original author’s source code.'}</p>
    <a class="underline" href="https://www.xiaohongshu.com/explore/6aa0570a000000002603b1ed" target="_blank" rel="noreferrer">{zh ? '前端按钮动效风格参考 01–04' : 'Button motion reference 01–04'}</a><span> · </span><a class="underline" href="https://www.xiaohongshu.com/explore/6aa189dd000000002b01e67c" target="_blank" rel="noreferrer">{zh ? '前端按钮动效风格参考 05–08' : 'Button motion reference 05–08'}</a>
  </details>
</BaseLayout>
