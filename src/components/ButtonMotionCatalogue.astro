---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonMotionDemo from '@/islands/ButtonMotionDemo';
import ButtonMotionReferences from '@/components/ButtonMotionReferences.astro';
import ButtonMotionPagination from '@/components/ButtonMotionPagination.astro';
import { BUTTON_MOTIONS, MOTION_PAGE_SIZE, MOTION_PAGE_COUNT, buttonMotionPath } from '@/lib/button-motions';
import { BUTTON_MOTION_DESCRIPTIONS } from '@/lib/button-motion-copy';
import { localePath, type Locale } from '@/lib/i18n';
interface Props { page: number; locale: Locale }
const { page, locale } = Astro.props;
const zh = locale === 'zh';
const start = (page - 1) * MOTION_PAGE_SIZE;
const motions = BUTTON_MOTIONS.slice(start, start + MOTION_PAGE_SIZE);
const path = buttonMotionPath(page);
const title = zh ? '按钮动效' : 'Button Motion';
---
<BaseLayout title={`${title} · ${page} / ${MOTION_PAGE_COUNT} · ${zh ? '界面图谱' : 'Interface Atlas'}`} description={zh ? '40 种可交互的按钮动效，每行一种，每页 10 种。' : '40 interactive button effects. One effect per row, ten per page.'} locale={locale} enPath={path}>
  <section class="pt-12 pb-3">
    <a href={localePath('/motion', locale)} class="text-sm text-ink-3 hover:text-accent">← {zh ? '动效' : 'Motion'}</a>
    <h1 class="mt-5 font-serif text-4xl font-semibold">{title}</h1>
    <p class="mt-3 text-sm leading-relaxed text-ink-2">{zh ? '40 种可交互效果，按提示悬停、点击、长按或拖动体验。' : '40 interactive effects. Hover, click, hold or drag as indicated to try each one.'}</p>
    <ButtonMotionReferences locale={locale} />
  </section>
  <ButtonMotionPagination page={page} locale={locale} position="top" />
  <div class="bm-catalogue py-2" data-motion-page={page}>
    {motions.map((motion, i) => <article id={motion.id} class="bm-row" data-motion-id={motion.id}>
      <div class="bm-meta">
        <div class="bm-heading">
          <p class="bm-number">{String(start + i + 1).padStart(2, '0')}</p>
          <div>
            <h2><a href={`#${motion.id}`}>{zh ? motion.zh : motion.en}</a></h2>
            {zh && <p class="bm-en">{motion.en}</p>}
          </div>
        </div>
        <p class="bm-description" id={`${motion.id}-description`}>{BUTTON_MOTION_DESCRIPTIONS[motion.id][locale]}</p>
        <details class="bm-parameters">
          <summary>{zh ? '动效参数' : 'Motion parameters'}</summary>
          <p>{zh ? '过渡时长' : 'Transition'} · {motion.duration} ms</p>
          <p>{motion.params}</p>
        </details>
      </div>
      <ButtonMotionDemo motion={motion} locale={locale} client:load />
    </article>)}
  </div>
  <div class="mb-12"><ButtonMotionPagination page={page} locale={locale} position="bottom" /></div>
</BaseLayout>
