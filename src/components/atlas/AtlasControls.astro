---
import type {Locale} from '@/lib/i18n';
interface Props{slug:string;locale:Locale}
const {slug,locale}=Astro.props;
const l=(zh:string,en:string)=>locale==='zh'?zh:en;
const rangeLabels:Record<string,[string,string,number]>={minimalism:['留白','Whitespace',60],'swiss-style':['字号','Type size',60],editorial:['阅读字号','Reading size',45],glassmorphism:['磨砂强度','Blur',55],'bento-grid':['拼块间距','Tile gap',45],neumorphism:['旋钮角度','Dial angle',40],skeuomorphism:['灯光亮度','Light',60],brutalism:['排印尺度','Type scale',60],neobrutalism:['硬阴影距离','Hard shadow',50],'flat-design':['图形比例','Shape scale',50],y2k:['镀铬亮度','Chrome light',50],cyberpunk:['信号亮度','Signal brightness',65],memphis:['图案尺度','Pattern scale',50],'retro-futurism':['音量','Volume',20],claymorphism:['柔软程度','Softness',60],aurora:['光谱色相','Spectrum hue',50],organic:['自然光','Daylight',60],'art-deco':['金线亮度','Gold intensity',65],'liquid-glass':['透镜厚度','Lens thickness',40],vaporwave:['梦境浓度','Atmosphere',55]};
const range=rangeLabels[slug];
const pixelColours=[['#142b42',l('深蓝','Navy')],['#fff1ce',l('米白','Cream')],['#73c9a3',l('薄荷绿','Mint')],['#f4bb56',l('金黄','Gold')],['#e77c72',l('珊瑚红','Coral')],['#76ace0',l('天空蓝','Sky blue')]];
---
<h2>{slug==='corporate-memphis'?l('02 试验','02 Experiment'):l('动手试试','Try it')}</h2>
{range && <label class="atlas-range-label" for="atlas-range"><span>{locale==='zh'?range[0]:range[1]}</span><output for="atlas-range" data-range-output>{slug==='neumorphism'?`${Math.round(range[2]*3.6)}°`:range[2]}</output><input id="atlas-range" data-art-range type="range" min="0" max="100" value={range[2]} aria-valuetext={slug==='neumorphism'?`${Math.round(range[2]*3.6)}°`:undefined}/></label>}
{slug==='bauhaus' && <><div class="atlas-tool-group" role="group" aria-label={l('添加几何形状','Add a shape')}><button type="button" data-shape="circle" aria-label={l('添加圆形','Add circle')}>●</button><button type="button" data-shape="square" aria-label={l('添加方形','Add square')}>■</button><button type="button" data-shape="triangle" aria-label={l('添加三角形','Add triangle')}>▲</button></div><div class="atlas-tool-group"><button type="button" data-undo disabled>{l('撤销','Undo')}</button><button type="button" data-redo disabled>{l('重做','Redo')}</button><button type="button" data-clear-shapes>{l('清空','Clear')}</button></div><p class="atlas-control-note">{l('点击形状，将它放进构图。','Add shapes to your composition.')}</p></>}
{slug==='pixel-art' && <><p id="atlas-pixel-help" class="atlas-control-note">{l('拖动连续绘制；方向键移动，空格填色。','Drag to paint. Arrow keys move; Space paints.')}</p><div class="atlas-pixel-palette" role="group" aria-label={l('画笔颜色','Paint colour')}>{pixelColours.map(([c,name],i)=><button type="button" data-pixel-color={c} style={`background:${c}`} aria-label={name} title={name} aria-pressed={i===0}/>)}</div><div class="atlas-pixel-grid" role="group" aria-describedby="atlas-pixel-help" aria-label={l('8×8 像素画布','8 by 8 pixel canvas')}>{Array.from({length:64},(_,i)=><button type="button" data-pixel={i} tabindex={i===0?0:-1} aria-label={`${l('像素','Pixel')} ${Math.floor(i/8)+1},${i%8+1}`} aria-pressed="false"/>)}</div><button type="button" data-clear-pixels>{l('清空画布','Clear canvas')}</button></>}
{slug==='corporate-memphis' && <><div class="atlas-checklist">{[l('确定信息层级','Set the hierarchy'),l('选择插画形态','Choose the illustration'),l('检查按钮反馈','Check button feedback')].map((text,i)=><label><input type="checkbox" data-task checked={i===0}/>{text}</label>)}</div><progress max="3" value="1" data-progress aria-label={l('试验进度','Progress')}/><output data-progress-output>1 / 3</output></>}
{slug==='hand-drawn' && <><label class="atlas-note-label">{l('今日灵感','A thought for today')}<textarea data-note-input aria-describedby="atlas-note-error" rows="4" placeholder={l('写下一点想法……','A small idea…')}/></label><small id="atlas-note-error" class="atlas-field-error" role="alert" hidden></small><button type="button" data-pin-note>{l('贴在纸上','Pin the note')} ↗</button><button type="button" data-clear-note>{l('清除','Clear')}</button><p class="atlas-note-result" data-note-result hidden></p></>}
{slug==='retro-web' && <div class="atlas-tool-group"><button type="button" data-folder-back disabled>← {l('后退','Back')}</button><button type="button" data-folder-forward disabled>{l('前进','Forward')} →</button><button type="button" data-folder-home>⌂ {l('根目录','Root')}</button></div>}
{slug==='retro-futurism' && <><div class="atlas-transport"><button type="button" data-synth-toggle aria-pressed="false">▶ {l('播放合成音','Play synth')}</button></div><p class="atlas-control-note">{l('本机合成音，点击后播放。','Locally synthesized audio. Starts on click.')}</p></>}
{['aurora','vaporwave'].includes(slug) && <label class="atlas-toggle"><input type="checkbox" data-atmosphere/>{l('光场缓慢流动','Animate atmosphere')}</label>}
{slug==='neumorphism' && <label class="atlas-toggle"><input type="checkbox" data-soft-light checked/>{l('柔光开启','Soft light')}</label>}
{slug==='bento-grid' && <label class="atlas-toggle"><input type="checkbox" data-compact/>{l('紧凑排列','Compact layout')}</label>}
{slug==='glassmorphism' && <label class="atlas-toggle"><input type="checkbox" data-glass-clear/>{l('查看清晰背景','Reveal the background')}</label>}
{slug==='flat-design' && <div class="atlas-tool-group" role="group" aria-label={l('布局方向','Layout direction')}><button type="button" data-flat-layout="horizontal" aria-pressed="true">↔ {l('横向','Row')}</button><button type="button" data-flat-layout="vertical" aria-pressed="false">↕ {l('纵向','Column')}</button></div>}
{slug==='claymorphism' && <div class="clay-touch-stage"><div class="clay-piece" data-clay-object aria-hidden="true"><i></i><i></i><b></b></div><button type="button" data-squish aria-describedby="clay-touch-hint">{l('按住捏一捏','Hold to squish')} ☁</button><small id="clay-touch-hint">{l('按住鼠标、触屏或空格键，松开回弹。','Hold with pointer or Space. Release to bounce back.')}</small><p data-clay-status class="atlas-feedback" role="status"></p></div>}
{slug==='neobrutalism' && <><button type="button" data-sticker>{l('贴一张！','Stick it!')} ★</button><div class="approved-stickers" data-stickers></div><p data-sticker-count class="atlas-feedback" role="status"></p></>}
{!['bauhaus','pixel-art','corporate-memphis','hand-drawn','retro-web'].includes(slug) && <button class="atlas-detail-button" type="button" data-current-example>{l('打开变体详情','Explore the variant')} ↗</button>}
