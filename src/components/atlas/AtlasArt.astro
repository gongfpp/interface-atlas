---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import AtlasVariantArt from './AtlasVariantArt.astro';
import type {Locale} from '@/lib/i18n';
import minimal from '@/assets/style-scenes/minimalism.png';
import editorial from '@/assets/style-scenes/editorial.png';
import materials from '@/assets/style-scenes/skeuomorphism.png';
import concrete from '@/assets/style-scenes/brutalism.png';
import mountains from '@/assets/style-scenes/mountains.png';
import botanical from '@/assets/style-scenes/organic-still-life.webp';
interface Props {slug:string;locale:Locale;variants: {name: Record<Locale,string>}[]}
const {slug,locale,variants}=Astro.props;
const l=(zh:string,en:string)=>locale==='zh'?zh:en;
const artworks=import.meta.glob<{default:ImageMetadata}>('../../assets/atlas/*.webp',{eager:true});
const production=artworks[`../../assets/atlas/${slug}.webp`]?.default;
const photos:Record<string,ImageMetadata>={minimalism:minimal,editorial,skeuomorphism:materials,brutalism:concrete,organic:botanical};
const photo=production??photos[slug];
const alt:Record<string,string>={minimalism:l('石材上的白色雕塑设备','White sculptural object on stone'),editorial:l('晨光里的书、咖啡与木桌','Books and coffee in morning light'),skeuomorphism:l('木桌上的相机与皮革物件','Camera and leather objects on a wooden desk'),brutalism:l('裸露混凝土建筑','Raw concrete architecture'),organic:l('自然光下的亚麻、陶杯与木器','Linen, ceramic and wood in daylight'),claymorphism:l('黏土小屋与手工作坊','A handmade clay workshop'),cyberpunk:l('雨中的霓虹街区','Neon district in the rain'),'pixel-art':l('有楼梯与植物的等距像素工作室','An isometric pixel studio'),'art-deco':l('黑金装饰艺术大厅','A black and gold Art Deco hall'),vaporwave:l('粉色大理石商场中庭','A pastel marble mall atrium'),y2k:l('透明翻盖手机与镀铬星星','A transparent flip phone and chrome star')};
---
{photo && slug!=='pixel-art' && <figure class="atlas-photo"><Image src={photo} alt={alt[slug]} width={1440} widths={[480,800,1440]} sizes="(max-width: 700px) 100vw, 75vw" format="webp" quality={85} loading="eager"/><figcaption><span data-art-caption>{l('界面图谱 · 视觉研究','INTERFACE ATLAS · VISUAL STUDY')}</span><button type="button" data-current-example>{l('探索','Explore')} ↗</button></figcaption></figure>}
{slug==='glassmorphism' && <div class="atlas-glass-stage"><Image src={mountains} alt={l('晨雾中的群山','Mountains in morning mist')} width={1440} format="webp"/><div class="atlas-glass-pane pane-back"></div><div class="atlas-glass-pane pane-front"><span>01 / LIGHT</span><h2>{l('清晨的湖','Morning light')}</h2><p>{l('光穿过雾，界面也可以如此。','A little clarity through the mist.')}</p><button type="button" data-current-example>{l('打开图层','Open layer')} ↗</button></div></div>}
{slug==='swiss-style' && <div class="atlas-swiss-poster" aria-hidden="true"><span>FORM<br/>FOLLOWS<br/>FUNCTION.</span><i></i><small>INTERNATIONAL<br/>TYPOGRAPHIC STYLE</small></div>}
{slug==='bento-grid' && <div class="atlas-bento-art"><div class="folded-art" aria-hidden="true"><i></i><i></i><i></i><i></i></div><button type="button" data-current-example><strong>{l('有秩序，才有呼吸感。','Order makes room to breathe.')}</strong><span>↗</span></button></div>}
{slug==='neumorphism' && <div class="atlas-dial-stage"><div class="atlas-dial"><span class="atlas-dial-tick"></span><strong data-dial-value>144°</strong><small>{l('柔和控制','SOFT CONTROL')}</small></div><div class="atlas-dial-track" aria-hidden="true">●　○　○</div></div>}
{slug==='neobrutalism' && <div class="atlas-sticker-board"><div class="atlas-star" aria-hidden="true">✹</div><strong>GOOD<br/>IDEAS<br/>STICK.</strong><button type="button" data-sticker>{l('贴一张！','STICK IT!')} ↗</button><div data-stickers aria-live="polite"></div></div>}
{slug==='retro-web' && <div class="atlas-retro-window"><div class="atlas-window-title">▣ {l('我的互联网','My Internet')}<button type="button" data-window-toggle aria-expanded="true" aria-controls="atlas-folder-view" aria-label={l('折叠或展开窗口','Collapse or expand window')}>−</button></div><div class="atlas-retro-address">{l('地址','Address')}: <span data-folder-path>atlas://home</span></div><div class="atlas-folder-content" id="atlas-folder-view" data-folder-content><h2>{l('欢迎回家！','WELCOME HOME!')}</h2><p>{l('选择一个文件夹开始探索。','Open a folder to start exploring.')}</p><div>{variants.map(({name},i)=><button type="button" data-folder={i}><span>▰</span>{name[locale]}</button>)}</div></div></div>}
{['flat-design','corporate-memphis'].includes(slug) && <div class="atlas-flat-art"><svg viewBox="0 0 700 440" fill="none" role="img" aria-label={l('协作中的抽象人物与几何形状','Abstract people collaborating with geometric shapes')}><path d="M20 310h660v100H20z" fill="#dce9ff"/><rect x="385" y="20" width="230" height="220" rx="5" fill="#ffd13b"/><circle cx="558" cy="77" r="32" fill="#fff"/><path d="m385 240 110-125 120 125" fill="#155be7"/><path d="M130 175c-20-56 45-105 85-63 29 31 1 75-29 88" fill="#132040"/><circle cx="205" cy="168" r="35" fill="#ff9c8d"/><path d="M142 205c-52 9-85 97-63 139l147 23 60-71-65-85z" fill="#145ee8"/><path d="m209 222 58 67 108-52 13 27-124 69-85-68" fill="#ff9c8d"/><path d="m136 340 144 10 130 78H280l-77-41-118 3z" fill="#132040"/><path d="m271 306 51-89h131l-53 89z" fill="white"/><path d="M486 339c-12-90 58-80 40-19 35-69 74-50 37-8 62-18 58 35-26 53" fill="#1fb397"/><path d="M492 352h60l-8 61h-41z" fill="#ff987f"/><path d="M85 132c-13-27-18-57 9-65 24-8 21 50 6 64z" fill="#ffd13b"/></svg><div class="atlas-flat-copy"><h2>{l('让创意，更简单。','Make room for ideas.')}</h2><button type="button" data-current-example>{l('探索构图','Explore the composition')} →</button></div></div>}
{slug==='bauhaus' && <div class="atlas-geometry-stage" data-geometry><span class="geometry-circle"></span><span class="geometry-square"></span><span class="geometry-triangle"></span><div data-shapes></div><small>FORM / COLOUR / SPACE</small></div>}
{slug==='memphis' && <div class="atlas-memphis-art"><span class="memphis-wave" aria-hidden="true"></span><div class="memphis-poster"><strong>GOOD<br/>IDEAS<br/>PLAY<br/>DIFFERENTLY.</strong><span class="memphis-orb" aria-hidden="true"></span><button type="button" data-current-example>{l('打破规则','Break the rules')} ↗</button></div><div class="memphis-pattern" aria-hidden="true"></div></div>}
{['retro-futurism','pixel-art'].includes(slug) && <div class="atlas-variant-hero"><AtlasVariantArt slug={slug} locale={locale}/>{slug==='retro-futurism' && <div class="atlas-waveform" data-waveform aria-hidden="true">{Array.from({length:32},(_,i)=><i style={`--wave:${20+((i*29)%70)}%`}/>)}</div>}</div>}
{slug==='aurora' && <div class="atlas-aurora-field"><div></div><span aria-hidden="true">FLOW<br/>WITHOUT<br/>BOUNDARIES.</span><button type="button" data-current-example>{l('进入光场','Into the light')} ↗</button></div>}
{slug==='hand-drawn' && <div class="atlas-sketch-art"><svg viewBox="0 0 600 400" fill="none" aria-hidden="true"><path d="m35 34 521-8 9 333-516 13z" fill="#f9f1d9" stroke="#353939" stroke-width="3"/><path d="m45 45 509-9M58 92l435-7M70 310l441-6" stroke="#3268bb" stroke-width="2"/><path d="m133 283 15-99 138 2-9 93zM160 199l102 2-8 64-103 2z" fill="#d4e1e5" stroke="#353939" stroke-width="3"/><path d="M285 283h148M344 282c-2-63-1-102 4-154M345 200c-65-2-73-63-39-49 29 11 39 33 39 49ZM348 169c5-58 82-53 43-17-20 16-34 17-43 17Z" fill="#91b487" stroke="#353939" stroke-width="3"/><path d="m314 282 71-1-13 47-43-2z" fill="#de9871" stroke="#353939" stroke-width="3"/><path d="M414 91c41 22 56 52 42 82m-12-14 12 14 16-14" stroke="#3268bb" stroke-width="4"/><path d="m98 35 72 1-2 33-75-4z" fill="#ead493"/></svg><p data-pinned-note>{l('一点想法，就能长出一整个世界。','A small thought can grow a whole world.')}</p></div>}
{slug==='liquid-glass' && <div class="atlas-optics-stage"><div class="optics-stripe stripe-cyan"></div><div class="optics-stripe stripe-gold"></div><div class="atlas-lens" data-lens></div><span class="optics-label">n = 1.52<br/>LIGHT / REFRACTION</span><span class="optics-scale" aria-hidden="true">0 ── 10 ── 20 ── 30</span></div>}
