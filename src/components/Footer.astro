---
import { type Locale, localePath, t } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const showVisitorCounts = Astro.site?.origin === 'https://atlas.gongfpp.icu' && import.meta.env.PUBLIC_PREVIEW !== 'true';
---

<footer class="mt-24 border-t border-line py-10 text-sm text-ink-3">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-5 md:px-8">
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-ink-2" aria-label={locale === 'zh' ? '次级导航' : 'Secondary navigation'}>
      <a class="hover:text-accent" href={localePath('/explore', locale)}>
        {locale === 'zh' ? '随机探索' : 'Explore'}
      </a>
      <a class="hover:text-accent" href={localePath('/compare', locale)}>
        {locale === 'zh' ? '概念对比' : 'Concept comparisons'}
      </a>
      <a class="hover:text-accent" href={localePath('/saved', locale)}>
        {locale === 'zh' ? '项目参考册' : 'Project notebook'}
      </a>
      <a class="hover:text-accent" href={localePath('/gallery', locale)}>
        {locale === 'zh' ? '灵感图库' : 'Gallery'}
      </a>
      <a class="hover:text-accent" href={localePath('/board', locale)}>
        {locale === 'zh' ? '留言板' : 'Board'}
      </a>
      <a class="hover:text-accent" href="https://github.com/gongfpp/interface-atlas/issues" target="_blank" rel="noopener noreferrer">
        {locale === 'zh' ? '问题与建议' : 'Issues & suggestions'}
      </a>
    </nav>
    <p class="font-serif text-ink-2">界面图谱 · Interface Atlas</p>
    <p>{t('footerNote', locale)}</p>
    {showVisitorCounts && (
      <p data-visitor-counts="atlas" hidden class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs tabular-nums" aria-label={locale === 'zh' ? '访问统计' : 'Visitor counts'} aria-busy="true">
        <span class="whitespace-nowrap">{locale === 'zh' ? '累计' : 'Total'} <span data-visitor-count="total">—</span></span>
        <span class="whitespace-nowrap">{locale === 'zh' ? '今日' : 'Today'} <span data-visitor-count="today">—</span></span>
        <span class="whitespace-nowrap">{locale === 'zh' ? '当前在线' : 'Online'} <span data-visitor-count="online">—</span></span>
      </p>
    )}
    <p class="text-xs">{locale === 'zh' ? '本站使用 Umami 匿名统计访问路径、停留、点击与复制/粘贴操作，用于改进内容；不记录输入或剪贴板正文。支持浏览器 Do Not Track 设置。' : 'We use Umami for anonymous visit paths, engagement, clicks and copy/paste actions to improve the atlas. Input and clipboard content is not recorded. Browser Do Not Track settings are respected.'}</p>
  </div>
</footer>

<script>
  import '@/lib/visitor-counts.js';
</script>

<style>
  [data-visitor-counts][hidden] { display:none; }
</style>
