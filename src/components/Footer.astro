---
import { type Locale, localePath, t } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<footer class="mt-24 border-t border-line py-10 text-sm text-ink-3">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-5 md:px-8">
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-ink-2" aria-label={locale === 'zh' ? '次级导航' : 'Secondary navigation'}>
      <a class="hover:text-accent" href={localePath('/explore', locale)}>
        {locale === 'zh' ? '随机探索' : 'Explore'}
      </a>
      <a class="hover:text-accent" href={localePath('/compare', locale)}>
        {locale === 'zh' ? '概念对比' : 'Concept comparisons'}
      </a>
      <a class="hover:text-accent" href={localePath('/saved', locale)}>
        {locale === 'zh' ? '项目参考册' : 'Project notebook'}
      </a>
      <a class="hover:text-accent" href={localePath('/gallery', locale)}>
        {locale === 'zh' ? '灵感图库' : 'Gallery'}
      </a>
      <a class="hover:text-accent" href={localePath('/board', locale)}>
        {locale === 'zh' ? '留言板' : 'Board'}
      </a>
    </nav>
    <p class="font-serif text-ink-2">界面图谱 · Interface Atlas</p>
    <p>{t('footerNote', locale)}</p>
    <p class="text-xs">{locale === 'zh' ? '本站使用 Umami 匿名统计访问、停留与点击，用于改进内容；不记录输入内容。支持浏览器 Do Not Track 设置。' : 'We use Umami for anonymous visit, engagement and click statistics to improve the atlas. Input content is not recorded. Browser Do Not Track settings are respected.'}</p>
  </div>
</footer>
