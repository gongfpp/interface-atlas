---
import { localePath, type Locale } from '@/lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<div class="bm-entry">
  <div>
    <a class="bm-entry-link" href={localePath('/motion/buttons', locale)}><strong>{locale === 'zh' ? '40 种按钮动效' : '40 button effects'}</strong><span aria-hidden="true">↗</span></a>
    <p>{locale === 'zh' ? '看效果说明，直接体验每一种交互。' : 'Read what changes, then try each interaction.'}</p>
  </div>
  <a class="bm-entry-originals" href={`${localePath('/motion/buttons', locale)}#design-originals`}>{locale === 'zh' ? '设计原图' : 'Design originals'} ↗</a>
</div>
<style>
  .bm-entry { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; margin-block: 24px 32px; padding: 18px 22px; border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-paper-raised); }
  .bm-entry-link { display: inline-flex; align-items: center; gap: 24px; color: var(--color-accent); }
  .bm-entry p { margin-top: 6px; font-size: 13px; color: var(--color-ink-secondary); }
  .bm-entry-originals { font-size: 14px; color: var(--color-ink-secondary); }
  .bm-entry a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media(max-width:700px) { .bm-entry { padding: 16px; } }
</style>
