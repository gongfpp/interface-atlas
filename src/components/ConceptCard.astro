---
import type { Concept } from '@/lib/content';
import { conceptPath } from '@/lib/content';
import { TYPE_LABELS, RELATION_LABELS, type Locale } from '@/lib/i18n';
import type { Relation } from '@/content.config';
import { demos } from '@/islands/demos/registry';
import StyleThumb from './StyleThumb.astro';
import { getStylePreviews } from '@/lib/style-previews';

interface Props {
  concept: Concept;
  locale: Locale;
  /** related 边的类型标签，仅在概念详情页的相关概念区传入 */
  relation?: Relation;
}
const { concept, locale, relation } = Astro.props;
const href = conceptPath(concept, locale);
const styleSpec = concept.conceptType === 'styles' ? (await getStylePreviews()).find(spec => spec.slug === concept.id) : undefined;
const Demo = !styleSpec && concept.data.demo ? demos[concept.data.demo.component] : undefined;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-line bg-raised transition-all hover:-translate-y-0.5 hover:border-line-strong hover:shadow-sm"
>
  {styleSpec && <div class="overflow-hidden border-b border-line" aria-hidden="true"><StyleThumb spec={styleSpec} locale={locale} compact /></div>}
  {Demo && (
    <div class="demo-stage-checker relative h-48 overflow-hidden border-b border-line p-4" aria-hidden="true" inert>
      <div class="pointer-events-none select-none origin-top-left w-[160%] scale-[.625]">
        <Demo mode="default" locale={locale} />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-transparent to-transparent transition-colors group-hover:bg-accent/5"></div>
    </div>
  )}
  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <div class="flex items-baseline justify-between gap-3">
      <span class="font-serif text-base font-semibold">{concept.data.name[locale]}</span>
      <span class="text-xs text-ink-3">{concept.data.name[locale === 'zh' ? 'en' : 'zh']}</span>
    </div>
    <p class="line-clamp-2 text-sm text-ink-2">{concept.data.description[locale]}</p>
    <span class="mt-auto flex items-center justify-between gap-2 pt-1 text-[11px] uppercase tracking-wider text-ink-3">
      <span class="transition-colors group-hover:text-accent">{TYPE_LABELS[concept.conceptType][locale]}</span>
      {relation && (
        <span class="rounded-full border border-line px-1.5 py-0.5 text-[10px] normal-case tracking-normal">
          {RELATION_LABELS[relation][locale]}
        </span>
      )}
    </span>
  </div>
</a>
