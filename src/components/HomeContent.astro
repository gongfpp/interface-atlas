---
import { getConcepts, POPULAR_IDS, type Concept, type ConceptType } from '@/lib/content';
import ConceptCard from '@/components/ConceptCard.astro';
import StyleThumb from '@/components/StyleThumb.astro';
import { getStylePreviews } from '@/lib/style-previews';
import { TYPE_LABELS, localePath, t, withBase, type Locale } from '@/lib/i18n';
import HeroSearch from '@/islands/HeroSearch';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const all = await Promise.all(
  (Object.keys(TYPE_LABELS) as ConceptType[]).map(async (t2) => ({
    type: t2,
    concepts: await getConcepts(t2),
  })),
);
const total = all.reduce((n, g) => n + g.concepts.length, 0);
const { getCollection: getCol } = await import('astro:content');
const gallery = (await getCol('gallery')).filter((e) => e.data.status === 'published');
const styleSpecs = await getStylePreviews();
const popular = (await Promise.all(
  (Object.keys(TYPE_LABELS) as ConceptType[]).map((t2) => getConcepts(t2)),
))
  .flat()
  .filter((c) => POPULAR_IDS.includes(c.id));

// 随机探索：把全部已发布条目注入页面，按钮本地随机跳转（PRD §8）
const allIds: Array<{ type: string; id: string }> = all.flatMap((g) =>
  g.concepts.map((c: Concept) => ({ type: g.type, id: c.id })),
);
---

<section class="home-hero">
  <div class="min-w-0">
    <p class="mb-5 font-mono text-[10px] tracking-[.22em] text-accent">A FIELD GUIDE TO DIGITAL INTERFACES</p>
    <h1 class="font-serif text-4xl font-semibold leading-[1.2] tracking-tight md:text-5xl">{locale === 'zh' ? '看见好设计，' : 'Discover the design.'}<br/><span class="text-accent">{locale === 'zh' ? '也看懂好设计。' : 'Understand the details.'}</span></h1>
    <p class="mt-5 max-w-lg text-sm leading-7 text-ink-2">{locale === 'zh' ? '从「这个叫什么」到「我也能实现」。探索视觉风格，亲手试用组件，把灵感变成下一次创作。' : 'From “what is that called?” to “I can build that.” Explore visual styles, try real components and turn inspiration into your next creation.'}</p>
    <HeroSearch client:load locale={locale} />
    <p class="mt-3 text-xs text-ink-3">{t('searchHint', locale)}</p>
    <div class="mt-6 flex flex-wrap gap-2">{[['/components', '探索组件', 'Explore components'], ['/styles', '寻找风格', 'Find a style'], ['/gallery', '浏览参考图', 'Visual references']].map(([path,zh,en]) => <a href={localePath(path,locale)} class="rounded-full border border-line bg-raised px-4 py-2 text-xs transition-colors hover:border-accent hover:text-accent">{locale === 'zh' ? zh : en} ↗</a>)}</div>
    <p class="mt-6 font-mono text-[11px] text-ink-3" data-testid="stats">{total} {t('entriesCount', locale)} · {all.length} {locale === 'zh' ? '大类型' : 'types'} · 中 / EN</p>
  </div>
  <div class="home-specimens" aria-label={locale === 'zh' ? '设计标本' : 'Design specimens'}>
    <a href={localePath('/styles/organic', locale)} class="home-organic"><span class="font-mono text-[9px] tracking-widest">01 / ORGANIC</span><span class="mt-5 block font-serif text-4xl leading-tight">Closer to<br/><i>nature.</i></span><span class="home-leaf" aria-hidden="true"></span><span class="mt-6 block text-xs">{locale === 'zh' ? '有机自然 · 探索风格' : 'Organic · Explore the style'} ↗</span></a>
    <a href={localePath('/components/tabs', locale)} class="home-mini"><span class="font-mono text-[9px] text-ink-3">02 / COMPONENTS</span><div class="my-4 flex gap-1 rounded-lg bg-code-bg p-1 text-[10px]"><span class="rounded-md bg-raised px-3 py-1.5 shadow-sm">{locale === 'zh' ? '概览' : 'Overview'}</span><span class="px-3 py-1.5 text-ink-3">{locale === 'zh' ? '动态' : 'Activity'}</span></div><span class="font-serif text-xl">{locale === 'zh' ? '细节，可以亲手体验。' : 'Details you can feel.'}</span><span class="mt-4 block text-xs text-accent">{locale === 'zh' ? '试用标签页' : 'Try tabs'} ↗</span></a>
    <a href={localePath('/styles/art-deco',locale)} class="home-deco"><span class="font-mono text-[9px] tracking-widest">03 / ART DECO</span><span class="my-4 block font-serif text-2xl">The art of<br/>the extraordinary.</span><span class="text-[10px] tracking-widest">{locale === 'zh' ? '装饰艺术' : 'ART DECO'} ↗</span></a>
  </div>
</section>

<section class="mb-12 border-y border-line py-5">
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">{(locale === 'zh' ? [['01','发现','按风格、组件或口语描述找到灵感。'],['02','体验','切换形式与尺寸，在真实交互中理解细节。'],['03','实现','复制说明与 Prompt，接入自己的项目。']] : [['01','Discover','Find an idea by style, component or plain language.'],['02','Explore','Try forms and sizes through real interactions.'],['03','Build','Bring the guidance and prompts into your own project.']]).map(([num,title,desc]) => <div class="flex gap-4"><span class="pt-1 font-mono text-xs text-accent">{num}</span><div><p class="text-sm font-medium">{title}</p><p class="mt-1 text-xs leading-6 text-ink-3">{desc}</p></div></div>)}</div>
</section>

<section class="pb-16">
  <div class="mb-5 flex flex-wrap items-end justify-between gap-3"><div><p class="mb-2 font-mono text-[10px] tracking-[.18em] text-accent">FRESH IN THE ATLAS</p><h2 class="font-serif text-2xl font-semibold">{locale === 'zh' ? '让界面更完整的六个组件' : 'Six more pieces of a complete interface'}</h2></div><a href={localePath('/components',locale)} class="text-sm text-accent">{t('viewAll',locale)} →</a></div>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">{all.flatMap(g=>g.concepts).filter(c=>['combobox','stepper','file-upload','rating','segmented-control','timeline'].includes(c.id)).map(c=><ConceptCard concept={c} locale={locale} />)}</div>
</section>

<!-- 风格 = 首页主视觉 -->
<section class="pb-16">
  <div class="mb-6 flex items-baseline justify-between">
    <div>
      <h2 class="font-serif text-2xl font-semibold md:text-3xl">{locale === 'zh' ? '先看风格' : 'Start with a style'}</h2>
      <p class="mt-1 text-sm text-ink-3">{locale === 'zh' ? `${styleSpecs.length} 种视觉语言，点开就是完整页面示范` : `${styleSpecs.length} visual languages — every card is a live page demo`}</p>
    </div>
    <a href={localePath('/styles', locale)} class="text-sm text-accent hover:underline">{t('viewAll', locale)} →</a>
  </div>
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {styleSpecs.slice(0, 6).map((spec) => (
      <a
        href={localePath(`/styles/${spec.slug}`, locale)}
        class="group transition-transform duration-300 hover:-translate-y-1"
        title={`${spec.nameZh} ${spec.nameEn}`}
      >
        <StyleThumb spec={spec} />
        <p class="mt-2.5 flex items-baseline justify-between px-0.5">
          <span class="font-serif text-lg font-semibold transition-colors group-hover:text-accent">{locale === 'zh' ? spec.nameZh : spec.nameEn}</span>
          <span class="text-sm text-ink-3">{locale === 'zh' ? spec.nameEn : spec.nameZh}</span>
        </p>
      </a>
    ))}
  </div>
</section>

<section class="pb-16">
  <div class="mb-6 flex items-baseline justify-between">
    <h2 class="font-serif text-2xl font-semibold md:text-3xl">{t('exploreByType', locale)}</h2>
  </div>
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
    {all.map(({ type, concepts }) => (
      <a
        href={localePath(`/${type}`, locale)}
        class="group rounded-lg border border-line bg-raised p-4 transition-all hover:-translate-y-0.5 hover:border-accent"
      >
        <p class="font-serif text-lg font-semibold group-hover:text-accent">{TYPE_LABELS[type][locale]}</p>
        <p class="text-xs text-ink-3">
          {concepts.length} {t('entriesCount', locale)}
        </p>
      </a>
    ))}
  </div>
</section>

<section class="pb-16">
  <div class="mb-5 flex items-baseline justify-between">
    <h2 class="font-serif text-2xl font-semibold md:text-3xl">{locale === 'zh' ? '灵感图库' : 'Gallery'}</h2>
    <a href={localePath('/gallery', locale)} class="text-sm text-accent hover:underline">{t('viewAll', locale)} →</a>
  </div>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
    {gallery.slice(0, 5).map((entry) => (
      <a
        href={localePath(`/gallery/${entry.id}`, locale)}
        class="group overflow-hidden rounded-lg border border-line bg-raised transition-all hover:-translate-y-0.5 hover:border-accent"
      >
        <img
          src={withBase(entry.data.images[0]?.file ?? '')}
          alt={entry.data.name[locale]}
          loading="lazy"
          width="800"
          height="1000"
          class="aspect-[4/5] w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
        />
        <p class="truncate p-2.5 text-sm font-medium group-hover:text-accent">{entry.data.name[locale]}</p>
      </a>
    ))}
  </div>
</section>

{popular.length > 0 && (
  <section class="pb-16">
    <h2 class="mb-5 font-serif text-2xl font-semibold md:text-3xl">{t('popularConcepts', locale)}</h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3">
      {popular.map((c) => <ConceptCard concept={c} locale={locale} />)}
    </div>
  </section>
)}

<section class="pb-20">
  <button
    id="random-btn"
    type="button"
    data-entries={JSON.stringify(allIds)}
    data-locale={locale}
    class="rounded-full border border-line px-5 py-2 text-sm text-ink-2 transition-colors hover:border-accent hover:text-accent"
  >
    🎲 {t('random', locale)}
  </button>
</section>

<script is:inline define:vars={{ base: import.meta.env.BASE_URL.replace(/\/+$/, '') }}>
  document.getElementById('random-btn')?.addEventListener('click', function () {
    const entries = JSON.parse(this.dataset.entries || '[]');
    if (!entries.length) return;
    const pick = entries[Math.floor(Math.random() * entries.length)];
    const prefix = this.dataset.locale === 'zh' ? '' : '/en';
    window.location.href = `${base}${prefix}/${pick.type}/${pick.id}`;
  });
</script>
