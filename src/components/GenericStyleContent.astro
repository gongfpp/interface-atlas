---

<div class="generic-style-content" data-generic-content style={`--gs-bg:${t.bg};--gs-fg:${t.fg};--gs-sub:${t.sub};--gs-accent:${t.accent};--gs-accent-fg:${t.accentFg};--gs-card:${t.card};--gs-border:${t.cardBorder};--gs-radius:${t.radius === '999px' ? '24px' : t.radius};--gs-shadow:${t.shadow ?? 'none'};font-family:${t.font}`}>
  <header class="gs-heading"><p class="gs-eyebrow">{spec.brand} / {l('交互空间','INTERACTIVE SPACE')}</p><h2>{titles[slug]}</h2><p>{l('这是本地体验：不会注册账号、发出订单或传送你的内容。','A local experience: no account is created, no order is placed, and your content is not sent anywhere.')}</p></header>
  <div class="gs-tabs" role="tablist" aria-label={l('浏览页面内容','Explore page content')}>
    {[workspaceLabels[slug], ...spec.nav].map((name, i) => <button type="button" role="tab" id={`gs-${slug}-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`gs-${slug}-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-generic-tab={i}>{name}</button>)}
  </div>
  <section class="gs-panel" role="tabpanel" id={`gs-${slug}-panel-0`} aria-labelledby={`gs-${slug}-tab-0`} data-generic-panel="0" tabindex="-1">
    {slug === 'flat-design' && <div class="gs-two"><form data-generic-form="workspace"><h3>{l('创建工作区','Create a workspace')}</h3><label>{l('工作区名称','Workspace name')}<input name="name" required maxlength="48" placeholder={l('例如：产品发布','e.g. Product launch')} /></label><label>{l('起步方案','Starting plan')}<select name="plan" data-feature-select><option>{l('个人 · 免费','Personal · Free')}</option><option>{l('团队 · 协作','Team · Collaborative')}</option><option>{l('Studio · 多项目','Studio · Multi-project')}</option></select></label><button class="gs-primary" type="submit">{l('创建本地工作区','Create local workspace')} →</button></form><article class="gs-card"><h3>{l('我的工作区','My workspaces')}</h3><p data-empty>{l('名称、计划、下一步，井井有条。','A name, a plan, and a clear next step.')}</p><ul class="gs-results" data-workspaces></ul></article></div>}
    {slug === 'bauhaus' && <div class="gs-two"><div><h3>{l('构图工坊','Composition workshop')}</h3><p>{l('选择基本形，再把它放入画面。最多放置 12 个形状。','Choose a form and place it on the canvas. Up to 12 shapes.')}</p><div class="gs-row">{['●','■','▲'].map((shape,i) => <button type="button" data-command="shape" data-value={i} aria-pressed={i===0?'true':'false'} aria-label={[l('红圆','Red circle'),l('蓝方','Blue square'),l('黄角','Yellow triangle')][i]}>{shape}</button>)}</div><div class="gs-row"><button type="button" class="gs-primary" data-command="place">{l('放置形状','Place shape')}</button><button type="button" data-command="clear-shapes">{l('清空构图','Clear canvas')}</button></div><p data-shape-count aria-live="polite">0 / 12</p></div><div class="gs-composition" data-composition role="img" aria-label={l('你的几何构图','Your geometric composition')}></div></div>}
