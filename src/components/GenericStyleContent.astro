---
import { localizeStylePreview, type StyleThumbSpec } from '@/lib/style-previews';
import type { Locale } from '@/lib/i18n';
import { getTeamSceneData, TEAM_INITIAL_DATE } from '@/lib/team-scene-data';
interface Props { spec: StyleThumbSpec; locale: Locale; }
const { spec: source, locale } = Astro.props;
const spec = localizeStylePreview(source, locale);
const l = (zh: string, en: string) => locale === 'zh' ? zh : en;
const slug = spec.slug;
const t = spec.tokens;
const team = getTeamSceneData(locale);
// 保留上方原品牌构图；下方延续同一产品场景，状态只存在于当前页面。
const titles: Record<string, string> = {
  'flat-design': l('一个清楚的开始。', 'A clear place to start.'),
  'bauhaus': l('形式，亲手组合。', 'Put form into practice.'),
  'y2k': l('你的千禧身份。', 'Your millennium identity.'),
  'cyberpunk': l('终端已就绪。', 'Your terminal is ready.'),
  'memphis': l('给派对一点个性。', 'Give the party a personality.'),
  'retro-futurism': l('下一站，日落。', 'Next stop, sunset.'),
  'claymorphism': l('捏一个新朋友。', 'Make a squishy friend.'),
  'aurora': l('调一束属于你的光。', 'Find your own light.'),
  'organic': l('从一件自然好物开始。', 'Start with something natural.'),
  'art-deco': l('为夜晚留席。', 'Make an evening of it.'),
  'corporate-memphis': l('让团队轻松向前。', 'Move forward, together.'),
  'hand-drawn': l('今天，想记下什么？', 'What will you remember today?'),
  'liquid-glass': l('在光学台上，探索材质。', 'Explore the optical workbench.'),
  'pixel-art': l('从一枚像素开始。', 'Start with one pixel.'),
  'vaporwave': l('下一层，永恒的夏天。', 'Next floor, endless summer.'),
};
// 原导航各自承载品牌内容，条目可收入本页清单、行程或设计参考。
const shelves: Record<string, { intro: string; items: string[]; verb: string }> = {
  'flat-design': { intro:l('从个人清单到团队协作，按需要选择；所有计划在此仅作本地预览。','From personal lists to team projects. Plans here are local previews only.'),items:[l('个人 · 免费 · 1 个工作区','Personal · Free · 1 workspace'),l('团队 · $12 / 月 · 共享项目','Team · $12 / month · Shared projects'),l('周刊 · 更清楚地安排每一天','Journal · A clearer everyday workflow')],verb:l('加入方案对比','Compare this option') },
  'bauhaus': { intro:l('让材料与形式服务于用途：工坊练习从三种基本形开始。','Let materials and form serve a purpose. Three shapes begin the workshop.'),items:[l('红圆 · 运动与平衡','Red circle · Movement and balance'),l('蓝方 · 空间与结构','Blue square · Space and structure'),l('黄角 · 方向与张力','Yellow triangle · Direction and tension')],verb:l('加入构图参考','Keep as a reference') },
  'y2k': { intro:l('银色舞池、透明配件、星球社群：为你的会员卡寻找灵感。','Silver dance floors, translucent accessories and a small planet of friends.'),items:[l('午夜 Mixtape · 12 首电子舞曲','Midnight Mixtape · 12 electronic tracks'),l('Chrome Club · 镀铬套装','Chrome Club · Metallic outfit'),l('Planet Dream · 闪星会员','Planet Dream · Star membership')],verb:l('加入我的星球','Add to my planet') },
  'cyberpunk': { intro:l('离线城市档案：挑选下一站，整理装备。不会连接任何真实网络。','An offline city archive. Plan your route and gear; no real network connection is made.'),items:[l('歌舞伎区 · 信号强度 92%','Kabuki · Signal strength 92%'),l('神经加速器 · +15% 反应速度','Neural accelerator · +15% response'),l('匿名信用芯片 · 300 credits','Anonymous credit chip · 300 credits')],verb:l('加入行动清单','Add to the mission') },
  'memphis': { intro:l('不必规整。把喜欢的图案、家具与小物放进下一场聚会。','Mix patterns, objects and furniture for a gathering that refuses to be ordinary.'),items:[l('波点花瓶 · 粉与绿','Polka-dot vase · Pink and green'),l('折线桌布 · 黄与蓝','Zigzag tablecloth · Yellow and blue'),l('周五设计派对 · Milano 20:00','Friday design party · Milano 20:00')],verb:l('加入派对灵感','Add to party inspiration') },
  'retro-futurism': { intro:l('来自一段想象中的公路旅程。电台使用本机合成音，不依赖外部音频。','A soundtrack for an imaginary road trip. The radio synthesizes sound locally, with no external audio.'),items:['01 · Midnight Drive / 84 BPM','02 · Neon Coast / 96 BPM',l('Sunset Tour · 洛杉矶 / 东京 / 柏林','Sunset Tour · Los Angeles / Tokyo / Berlin')],verb:l('加入旅行清单','Add to the road trip') },
  'claymorphism': { intro:l('小屋里的每个朋友，都从一个软软的形状开始。','Every friend in the cabin begins with a soft little shape.'),items:[l('蓝莓团子 · 喜欢午睡','Blueberry blob · Loves a nap'),l('桃子小熊 · 喜欢拥抱','Peach bear · Loves a hug'),l('薄荷小屋 · 留一个空位','Mint cabin · Room for a friend')],verb:l('放进我的小屋','Keep in my cabin') },
  'aurora': { intro:l('光、色、场，构成安静的数字夜空。选择一个观测地点，留作你的光场参考。','Light, color and space form a quiet digital sky. Keep an observation as a reference.'),items:[l('绿色帷幕 · 冷色与宁静','Green curtains · Cool and calm'),l('紫色脉冲 · 柔和的层次','Violet pulse · Soft depth'),l('午夜观测站 · 空旷的地平线','Midnight observatory · An open horizon')],verb:l('存入光场参考','Keep this light reference') },
  'organic': { intro:l('少一点消耗，多一点相处。认识材料的来源，让一件物品用得更久。','Less consumption, more connection. Know the materials and keep objects for longer.'),items:[l('亚麻织物 · 自然透气','Linen textile · Naturally breathable'),l('手作陶器 · 小批次烧制','Hand-thrown ceramics · Small-batch firing'),l('FSC 木材 · 可追溯来源','FSC timber · Traceable origins')],verb:l('加入生活清单','Add to my living list') },
  'art-deco': { intro:l('金色线条之下，是值得慢慢品味的夜晚。探索空间与餐饮，再预留一席。','Beyond the golden lines, an evening to savor. Explore the rooms and the menu, then save your seat.'),items:[l('The Salon · 香槟与爵士','The Salon · Champagne and jazz'),l('The Gallery · 五道式季节晚宴','The Gallery · Five-course seasonal dinner'),l('The Aurelia · 始于 1926 的待客艺术','The Aurelia · Hospitality since 1926')],verb:l('加入晚宴心愿单','Add to my evening wishlist') },
  'corporate-memphis': { intro:l('人先于流程。看看团队故事、透明方案与正在寻找的新伙伴。','People before process. Team stories, clear plans and new people to meet.'),items:[l('Studio Lila · 6 人跨时区协作','Studio Lila · Six people, different time zones'),l('Starter · 免费 · 最多 5 位伙伴','Starter · Free · Up to five teammates'),l('招聘 · 产品设计师 / 远程','Careers · Product designer / Remote')],verb:l('加入团队资料夹','Keep in team resources') },
  'hand-drawn': { intro:l('纸张、墨水与小小的观察。留下灵感，日记不必写得完美。','Paper, ink and little observations. Keep a spark; a journal need not be perfect.'),items:[l('横线纸 · 适合每天写一点','Ruled paper · A little writing each day'),l('暖橘色马克笔 · 留给重要的小事','Warm orange marker · For the little things that matter'),l('关于 scribble& · 为不完美留白','About scribble& · Space for imperfection')],verb:l('夹进灵感本','Keep in my notebook') },
  'liquid-glass': { intro:l('用可读的内容检验材质，而不只是追逐光效。参数只作用于下方试样。','Test a material against readable content, not just highlights. Controls affect only the specimen below.'),items:[l('光学 · 透镜厚度与边缘高光','Optics · Lens depth and edge highlights'),l('材质 · Frost / Clear / Prism','Materials · Frost / Clear / Prism'),l('Studio · $24 / 月 · 材质库预览','Studio · $24 / month · Material library preview')],verb:l('放入材质样本夹','Keep in material samples') },
  'pixel-art': { intro:l('硬边、有限色与明确的格子。打开图鉴，给下一位像素角色找点灵感。','Sharp edges, limited colors and a clear grid. Browse the atlas for your next sprite.'),items:[l('图鉴 #001 · 日落史莱姆','Atlas #001 · Sunset slime'),l('图鉴 #002 · 夜行机器人','Atlas #002 · Night robot'),l('商店 · 六色基础色板 / 免费','Shop · Six-color starter palette / Free')],verb:l('加入像素背包','Keep in pixel inventory') },
  'vaporwave': { intro:l('一座不会打烊的想象商场。浏览音像店、美食广场与中庭的楼层导览。','An imaginary mall that never closes. Find records, the food court and the atrium.'),items:[l('1F · Sunset Records · 黑胶与磁带','1F · Sunset Records · Vinyl and tapes'),l('2F · Peach Soda · 美食广场','2F · Peach Soda · Food court'),l('3F · Sky Garden · 屋顶落日','3F · Sky Garden · Rooftop sunset')],verb:l('盖一枚商场印章','Stamp my mall passport') },
};
const shelf = shelves[slug];
const workspaceLabels: Record<string,string> = { 'flat-design':l('工作区','Workspace'),bauhaus:l('构图台','Composition'),y2k:l('会员卡','Member card'),cyberpunk:l('终端','Terminal'),memphis:l('邀请卡','Invitation'),'retro-futurism':l('播放器','Player'),claymorphism:l('小团子','My blob'),aurora:l('光场台','Light field'),organic:l('生活清单','Living list'),'art-deco':l('晚宴计划','Evening plan'),'corporate-memphis':l('团队看板','Team board'),'hand-drawn':l('写一笔','Write a note'),'liquid-glass':l('材质台','Specimen'),'pixel-art':l('画板','Canvas'),vaporwave:l('商场护照','Mall passport') };
// 每个导航目的地使用不同的场景内容；主 CTA 单独进入工作区。
const destinations: Record<string,string[][]> = {
