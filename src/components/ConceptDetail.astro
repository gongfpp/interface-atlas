---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import CompareTable from '@/components/CompareTable.astro';
import StyleThumb from '@/components/StyleThumb.astro';
import DemoMount from '@/islands/demos/DemoMount';
import PromptBlock from '@/islands/PromptBlock';
import { conceptPath, resolveRelated, getAllConcepts, type Concept } from '@/lib/content';
import { comparePath } from '@/lib/compare';
import { getStylePreviews } from '@/lib/style-previews';
import { TYPE_LABELS, type Locale } from '@/lib/i18n';

interface Props {
  concept: Concept;
  locale: Locale;
}

const { concept, locale } = Astro.props;
const d = concept.data;
const otherLocale = locale === 'zh' ? 'en' : 'zh';

const related = await resolveRelated(d.related);
const all = await getAllConcepts();
const compareMembers = d.compare
  ? [
      concept,
      ...all.filter((c) => c.data.compare?.group === d.compare!.group && c.id !== concept.id),
    ]
  : [];
const styleSpec = concept.conceptType === 'styles'
  ? (await getStylePreviews()).find((s) => s.slug === concept.id)
  : undefined;

const sectionTitle = 'mb-4 font-serif text-xl font-semibold';
const card = 'rounded-xl border border-line bg-raised p-5';
---

<BaseLayout
  title={`${d.name[locale]}（${d.name[otherLocale]}）· ${TYPE_LABELS[concept.conceptType][locale]} · 界面图谱`}
  description={d.description[locale].slice(0, 150)}
  locale={locale}
  enPath={`/${concept.conceptType}/${concept.id}`}
>
  <article class="pt-10">
    <header class="border-b border-line pb-8">
      <a href={`/${locale === 'zh' ? '' : 'en/'}${concept.conceptType}`}
         class="text-xs uppercase tracking-[0.2em] text-accent">
        {TYPE_LABELS[concept.conceptType][locale]}
      </a>
      {d.category.length > 0 && (
        <span class="ml-3 text-xs text-ink-3">{d.category.join(' / ')}</span>
      )}
      <h1 class="mt-3 font-serif text-4xl font-semibold md:text-5xl">{d.name[locale]}</h1>
      <p class="mt-2 text-lg text-ink-2">{d.name[otherLocale]}</p>
      {d.aliases.length > 0 && (
        <p class="mt-4 text-sm text-ink-3">
          <span class="mr-2">{locale === 'zh' ? '别名' : 'Aliases'}:</span>
          {d.aliases.map((a) => (
            <span class="mr-2 inline-block rounded-full border border-line px-2 py-0.5">{a}</span>
          ))}
        </p>
      )}
    </header>

    <section class="py-10">
      <h2 class={sectionTitle}>{locale === 'zh' ? '这是什么' : 'What is it'}</h2>
      <p class="max-w-3xl leading-relaxed text-ink-2">{d.description[locale]}</p>
    </section>

    {styleSpec && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '风格实况' : 'The look in practice'}</h2>
        <StyleThumb spec={styleSpec} />
      </section>
    )}

    {d.style_spec && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '开发规格' : 'Design spec'}</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { k: 'Typography', label: locale === 'zh' ? '字体' : 'Typography', v: d.style_spec.typography },
            { k: 'Color', label: locale === 'zh' ? '色彩' : 'Color', v: d.style_spec.color },
            { k: 'Border', label: locale === 'zh' ? '边框' : 'Border', v: d.style_spec.border },
            { k: 'Shadow', label: locale === 'zh' ? '阴影' : 'Shadow', v: d.style_spec.shadow },
            { k: 'Spacing', label: locale === 'zh' ? '间距' : 'Spacing', v: d.style_spec.spacing },
          ].map(({ label, v }) => (
            <div class="rounded-lg border border-line bg-raised p-3.5">
              <p class="mb-1 text-[11px] uppercase tracking-wider text-ink-3">{label}</p>
              <p class="text-sm leading-relaxed text-ink-2">{v[locale]}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {d.demo && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '可运行示例' : 'Live demo'}</h2>
        <DemoMount
          client:visible
          component={d.demo.component}
          modes={d.demo.modes}
          locale={locale}
          anatomy={d.anatomy}
          motion={concept.conceptType === 'motion'}
        />
      </section>
    )}

    <section class="grid gap-5 pb-10 md:grid-cols-2">
      <div class={card}>
        <h2 class={`mb-3 font-serif text-lg font-semibold text-green-700 dark:text-green-400`}>
          ✓ {locale === 'zh' ? '适用场景' : 'When to use'}
        </h2>
        <ul class="space-y-2 text-sm leading-relaxed text-ink-2">
          {d.use_when.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
      <div class={card}>
        <h2 class={`mb-3 font-serif text-lg font-semibold text-accent`}>
          ✕ {locale === 'zh' ? '不适用场景' : 'When not to use'}
        </h2>
        <ul class="space-y-2 text-sm leading-relaxed text-ink-2">
          {d.avoid_when.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
    </section>

    {d.variants.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '常见形式' : 'Variants'}</h2>
        <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
          {d.variants.map((v) => (
            <div class="rounded-lg border border-line bg-raised p-4">
              <p class="font-medium">{v.name[locale]}</p>
              <p class="text-xs text-ink-3">{v.name[otherLocale]}</p>
              {v.note && <p class="mt-2 text-sm text-ink-2">{v.note[locale]}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {d.implementation && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '实现要点' : 'Implementation'}</h2>
        <div class={card}>
          <div class="mb-3 flex flex-wrap gap-2">
            {d.implementation.css.map((css) => (
              <code class="rounded bg-code-bg px-2 py-1 font-mono text-xs">{css}</code>
            ))}
          </div>
          <p class="text-sm leading-relaxed text-ink-2">{d.implementation.notes[locale]}</p>
        </div>
      </section>
    )}

    {d.api.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '平台 API' : 'Platform API'}</h2>
        <div class={`${card} flex flex-wrap gap-2`}>
          {d.api.map((sym) => (
            <code class="rounded bg-code-bg px-2 py-1 font-mono text-xs">{sym}</code>
          ))}
        </div>
      </section>
    )}

    {compareMembers.length > 1 && d.compare && (
      <section class="pb-10">
        <div class="mb-4 flex items-baseline justify-between gap-3">
          <h2 class="font-serif text-xl font-semibold">{locale === 'zh' ? '横向对比' : 'Compare'}</h2>
          <a href={comparePath(d.compare.group, locale)} class="shrink-0 text-sm text-accent hover:underline">
            {locale === 'zh' ? '查看完整对比' : 'Full comparison'} →
          </a>
        </div>
        <CompareTable concepts={compareMembers} locale={locale} />
      </section>
    )}

    <section class="pb-10">
      <h2 class={sectionTitle}>{locale === 'zh' ? '交给 AI' : 'Agent prompts'}</h2>
      <PromptBlock client:visible prompts={d.prompts} locale={locale} conceptName={concept.id} />
    </section>

    {related.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '相关概念' : 'Related concepts'}</h2>
        <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
          {related.map((r) => <ConceptCard concept={r.concept} locale={locale} relation={r.relation} />)}
        </div>
      </section>
    )}

    {d.applicable_styles.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '可搭配的风格' : 'Applicable styles'}</h2>
        <div class="flex flex-wrap gap-2">
          {d.applicable_styles.map((sid) => (
            <a href={conceptPath({ id: sid, conceptType: 'styles' } as Concept, locale)}
               class="rounded-full border border-line px-3 py-1 text-sm text-ink-2 hover:border-accent hover:text-accent">
              {sid}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="pb-16">
      <h2 class={sectionTitle}>{locale === 'zh' ? '参考来源' : 'Sources'}</h2>
      <ul class="space-y-1 text-sm">
        {d.sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-ink-2 underline decoration-line hover:text-accent">
              {s.name} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
