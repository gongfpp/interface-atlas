---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConceptCard from '@/components/ConceptCard.astro';
import CompareTable from '@/components/CompareTable.astro';
import StyleThumb from '@/components/StyleThumb.astro';
import DemoMount from '@/islands/demos/DemoMount';
import PromptBlock from '@/islands/PromptBlock';
import PromptBuilder from '@/islands/PromptBuilder';
import ConceptActions from '@/islands/ConceptActions';
import { conceptPath, resolveRelated, getAllConcepts, type Concept } from '@/lib/content';
import { comparePath } from '@/lib/compare';
import { getStylePreviews } from '@/lib/style-previews';
import { TYPE_LABELS, localePath, withBase, type Locale } from '@/lib/i18n';

interface Props {
  concept: Concept;
  locale: Locale;
}

const { concept, locale } = Astro.props;
const d = concept.data;
const otherLocale = locale === 'zh' ? 'en' : 'zh';

const related = await resolveRelated(d.related);
const all = await getAllConcepts();
const compareMembers = d.compare
  ? [
      concept,
      ...all.filter((c) => c.data.compare?.group === d.compare!.group && c.id !== concept.id),
    ]
  : [];

const styleOptions = all
  .filter((c) => c.conceptType === 'styles')
  .map((c) => ({ id: c.id, name: c.data.name[locale], guide: c.data.prompts.design[locale] }))
  .sort((a, b) => a.name.localeCompare(b.name));
const styleSpec = concept.conceptType === 'styles'
  ? (await getStylePreviews()).find((s) => s.slug === concept.id)
  : undefined;

const references = (await getCollection('gallery')).filter(g => g.data.status === 'published' && (g.data.related_component === concept.id || (concept.id === 'menu' && g.data.related_component === 'dropdown')));
const sectionTitle = 'mb-4 font-serif text-xl font-semibold';
const card = 'rounded-xl border border-line bg-raised p-5';
---

<BaseLayout
  title={`${d.name[locale]}（${d.name[otherLocale]}）· ${TYPE_LABELS[concept.conceptType][locale]} · 界面图谱`}
  description={d.description[locale].slice(0, 150)}
  locale={locale}
  enPath={`/${concept.conceptType}/${concept.id}`}
>
  <article class="pt-10 min-w-0">
    <header class="border-b border-line pb-8">
      <a href={localePath(`/${concept.conceptType}`, locale)}
         class="text-xs uppercase tracking-[0.2em] text-accent">
        {TYPE_LABELS[concept.conceptType][locale]}
      </a>
      {d.category.length > 0 && (
        <span class="ml-3 text-xs text-ink-3">{d.category.join(' / ')}</span>
      )}
      <div class="mt-3 flex items-start justify-between gap-4">
        <div>
          <h1 class="font-serif text-4xl font-semibold md:text-5xl">{d.name[locale]}</h1>
          <p class="mt-2 text-lg text-ink-2">{d.name[otherLocale]}</p>
          {d.aliases.length > 0 && (
            <p class="mt-4 text-sm text-ink-3">
              <span class="mr-2">{locale === 'zh' ? '别名' : 'Aliases'}:</span>
              {d.aliases.map((a) => (
                <span class="mr-2 inline-block rounded-full border border-line px-2 py-0.5">{a}</span>
              ))}
            </p>
          )}
        </div>
        <ConceptActions client:load conceptId={concept.id} locale={locale} />
      </div>
    </header>

    <nav class="detail-nav" aria-label={locale === 'zh' ? '本页目录' : 'On this page'}>
      <a href="#overview">{locale === 'zh' ? '概览' : 'Overview'}</a>
      {d.demo && <a href="#playground">{locale === 'zh' ? '交互实验室' : 'Playground'}</a>}
      <a href="#variants">{locale === 'zh' ? '形式与用法' : 'Variants'}</a>
      {references.length > 0 && <a href="#references">{locale === 'zh' ? '设计参考' : 'Visual references'}</a>}
      <a href="#implementation">{locale === 'zh' ? '实现要点' : 'Implementation'}</a>
      <a href="#prompts">{locale === 'zh' ? '复制 Prompt' : 'Prompts'}</a>
    </nav>
    <section id="overview" class="py-8">
      <h2 class={sectionTitle}>{locale === 'zh' ? '这是什么' : 'What is it'}</h2>
      <p class="max-w-3xl leading-relaxed text-ink-2">{d.description[locale]}</p>
      {d.disambiguation && (
        <div class="mt-5 max-w-3xl rounded-xl border border-line bg-raised p-5">
          <h3 class="mb-2 text-sm font-semibold text-accent">
            {locale === 'zh' ? '名词辨析' : 'Name disambiguation'}
          </h3>
          <p class="text-sm leading-relaxed text-ink-2">{d.disambiguation[locale]}</p>
        </div>
      )}
    </section>

    {styleSpec && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '风格实况' : 'The look in practice'}</h2>
        <StyleThumb spec={styleSpec} />
      </section>
    )}

    {d.style_spec && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '开发规格' : 'Design spec'}</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { k: 'Typography', label: locale === 'zh' ? '字体' : 'Typography', v: d.style_spec.typography },
            { k: 'Color', label: locale === 'zh' ? '色彩' : 'Color', v: d.style_spec.color },
            { k: 'Border', label: locale === 'zh' ? '边框' : 'Border', v: d.style_spec.border },
            { k: 'Shadow', label: locale === 'zh' ? '阴影' : 'Shadow', v: d.style_spec.shadow },
            { k: 'Spacing', label: locale === 'zh' ? '间距' : 'Spacing', v: d.style_spec.spacing },
          ].map(({ label, v }) => (
            <div class="rounded-lg border border-line bg-raised p-3.5">
              <p class="mb-1 text-[11px] uppercase tracking-wider text-ink-3">{label}</p>
              <p class="text-sm leading-relaxed text-ink-2">{v[locale]}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {d.demo && (
      <section id="playground" class="pb-10">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="detail-section-title font-serif text-2xl font-semibold" data-number="01">{locale === 'zh' ? '交互实验室' : 'Interactive playground'}</h2>
          <span class="text-xs text-ink-3">{locale === 'zh' ? '试一试，再决定怎么用' : 'Try it. Make an informed choice.'}</span>
        </div>
        {d.playground && <p class="mb-4 max-w-3xl text-sm leading-relaxed text-ink-2">{d.playground.task[locale]}</p>}
        <DemoMount
          client:visible
          component={d.demo.component}
          modes={d.demo.modes}
          locale={locale}
          anatomy={d.anatomy}
          motion={concept.conceptType === 'motion'}
          motionControls={d.demo.motionControls}
        />
        {d.playground && <div class="mt-4 rounded-xl border border-line bg-raised p-5">
          <h3 class="mb-3 text-sm font-semibold">{locale === 'zh' ? '使用时关注什么' : 'What to look for'}</h3>
          <ul class="grid gap-3 text-sm leading-relaxed text-ink-2 md:grid-cols-2">{d.playground.checks.map((check, i) => <li class="flex gap-3"><span class="font-mono text-xs text-accent">0{i + 1}</span><span>{check[locale]}</span></li>)}</ul>
        </div>}
      </section>
    )}

    {references.length > 0 && <section id="references" class="pb-10">
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class={sectionTitle}>{locale === 'zh' ? '从参考到实践' : 'From reference to practice'}</h2>
        <p class="text-xs text-ink-3">{locale === 'zh' ? 'AI 生成的视觉参考 · 点击查看完整图集' : 'AI-generated visual references · Open the full collection'}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">{references[0].data.images.slice(0, 3).map((img, i) => <a class="reference-card group" href={localePath(`/gallery/${references[0].id}`, locale)}>
        <div class="h-56 overflow-hidden bg-code-bg"><img class="w-full transition-transform duration-300 group-hover:scale-105" src={withBase(img.file)} alt={img.title[locale]} loading="lazy" width="800" height="1067" /></div>
        <p class="flex gap-3 border-t border-line p-4 text-sm"><span class="font-mono text-xs text-accent">0{i + 1}</span>{img.title[locale]} <span class="ml-auto">↗</span></p>
      </a>)}</div>
    </section>}

    <section class="grid gap-5 pb-10 md:grid-cols-2">
      <div class={card}>
        <h2 class={`mb-3 font-serif text-lg font-semibold text-green-700 dark:text-green-400`}>
          ✓ {locale === 'zh' ? '适用场景' : 'When to use'}
        </h2>
        <ul class="space-y-2 text-sm leading-relaxed text-ink-2">
          {d.use_when.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
      <div class={card}>
        <h2 class={`mb-3 font-serif text-lg font-semibold text-accent`}>
          ✕ {locale === 'zh' ? '不适用场景' : 'When not to use'}
        </h2>
        <ul class="space-y-2 text-sm leading-relaxed text-ink-2">
          {d.avoid_when.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
    </section>

    {d.variants.length > 0 && (
      <section id="variants" class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '常见形式' : 'Variants'}</h2>
        <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
          {d.variants.map((v) => (
            <div class="rounded-lg border border-line bg-raised p-4">
              <p class="font-medium">{v.name[locale]}</p>
              <p class="text-xs text-ink-3">{v.name[otherLocale]}</p>
              {v.note && <p class="mt-2 text-sm text-ink-2">{v.note[locale]}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {d.structure && d.structure.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '页面结构' : 'Page structure'}</h2>
        <ol class="grid gap-3 sm:grid-cols-2">
          {d.structure.map((s, i) => (
            <li class={`${card} flex gap-3`}>
              <span class="font-mono text-xs leading-6 text-ink-3">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="font-medium">{s.part[locale]}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink-2">{s.note[locale]}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {d.implementation && (
      <section id="implementation" class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '实现要点' : 'Implementation'}</h2>
        <div class={card}>
          <div class="mb-3 flex flex-wrap gap-2">
            {d.implementation.css.map((css) => (
              <code class="rounded bg-code-bg px-2 py-1 font-mono text-xs">{css}</code>
            ))}
          </div>
          <p class="text-sm leading-relaxed text-ink-2">{d.implementation.notes[locale]}</p>
        </div>
      </section>
    )}

    {d.api.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '平台 API' : 'Platform API'}</h2>
        <div class={`${card} flex flex-wrap gap-2`}>
          {d.api.map((sym) => (
            <code class="rounded bg-code-bg px-2 py-1 font-mono text-xs">{sym}</code>
          ))}
        </div>
      </section>
    )}

    {d.framework_names.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '代码里叫什么' : 'In code'}</h2>
        <p class="mb-3 text-sm text-ink-3">
          {locale === 'zh'
            ? '同一控件在不同体系里的叫号——用对名字，Prompt 和检索才准。'
            : 'The exact names this thing goes by in each ecosystem — use the row that matches your project.'}
        </p>
        <div class={`${card} overflow-x-auto`}>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-line text-left text-xs uppercase tracking-wider text-ink-3">
                <th class="py-2 pr-4 font-medium">{locale === 'zh' ? '体系' : 'Framework'}</th>
                <th class="py-2 font-medium">{locale === 'zh' ? '名称' : 'Name'}</th>
              </tr>
            </thead>
            <tbody>
              {d.framework_names.map((f) => (
                <tr class="border-b border-line/60 last:border-0">
                  <td class="py-2.5 pr-4 align-top text-ink-2">{f.framework}</td>
                  <td class="py-2.5 align-top">
                    {f.url ? (
                      <a href={f.url} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-accent hover:underline">{f.name}</a>
                    ) : (
                      <code class="rounded bg-code-bg px-2 py-0.5 font-mono text-xs">{f.name}</code>
                    )}
                    {f.note && <p class="mt-1 text-xs text-ink-3">{f.note[locale]}</p>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {compareMembers.length > 1 && d.compare && (
      <section class="pb-10">
        <div class="mb-4 flex items-baseline justify-between gap-3">
          <h2 class="font-serif text-xl font-semibold">{locale === 'zh' ? '横向对比' : 'Compare'}</h2>
          <a href={comparePath(d.compare.group, locale)} class="shrink-0 text-sm text-accent hover:underline">
            {locale === 'zh' ? '查看完整对比' : 'Full comparison'} →
          </a>
        </div>
        <CompareTable concepts={compareMembers} locale={locale} />
      </section>
    )}

    <section id="prompts" class="pb-10">
      <h2 class={sectionTitle}>{locale === 'zh' ? '交给 AI' : 'Agent prompts'}</h2>
      <PromptBlock client:visible prompts={d.prompts} locale={locale} conceptName={concept.id} />
    </section>

    <section class="pb-10">
      <h2 class={sectionTitle}>{locale === 'zh' ? '定制 Prompt' : 'Prompt builder'}</h2>
      <p class="mb-3 text-sm text-ink-3">
        {locale === 'zh'
          ? '在概念 Prompt 基础上叠加风格与附加要求，组合成一条可直接交给 Coding Agent 的任务。'
          : 'Combine this concept with a style and extra requirements into one agent-ready task.'}
      </p>
      <PromptBuilder
        client:visible
        conceptName={concept.id}
        agentPrompt={d.prompts.agent[locale]}
        styles={styleOptions}
        locale={locale}
      />
    </section>

    {related.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '相关概念' : 'Related concepts'}</h2>
        <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
          {related.map((r) => <ConceptCard concept={r.concept} locale={locale} relation={r.relation} />)}
        </div>
      </section>
    )}

    {d.confusable.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '容易混淆' : 'Not to be confused with'}</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {d.confusable.map((c) => {
            const target = all.find((x) => x.id === c.id);
            return (
              <div class={card}>
                {target ? (
                  <a href={conceptPath(target, locale)} class="font-medium text-accent hover:underline">
                    {target.data.name[locale]}
                    <span class="ml-2 text-xs font-normal text-ink-3">{target.data.name[otherLocale]}</span>
                  </a>
                ) : (
                  <span class="font-medium">{c.id}</span>
                )}
                <p class="mt-2 text-sm leading-relaxed text-ink-2">{c.note[locale]}</p>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {d.applicable_styles.length > 0 && (
      <section class="pb-10">
        <h2 class={sectionTitle}>{locale === 'zh' ? '可搭配的风格' : 'Applicable styles'}</h2>
        <div class="flex flex-wrap gap-2">
          {d.applicable_styles.map((sid) => (
            <a href={conceptPath({ id: sid, conceptType: 'styles' } as Concept, locale)}
               class="rounded-full border border-line px-3 py-1 text-sm text-ink-2 hover:border-accent hover:text-accent">
              {sid}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="pb-16">
      <h2 class={sectionTitle}>{locale === 'zh' ? '参考来源' : 'Sources'}</h2>
      <ul class="space-y-1 text-sm">
        {d.sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-ink-2 underline decoration-line hover:text-accent">
              {s.name} ↗
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-xs text-ink-3">
        <a class="underline decoration-line hover:text-accent" href={withBase(`/${concept.conceptType}/${concept.id}.md`)}>
          {locale === 'zh' ? 'Markdown 版（给 Agent）' : 'Markdown for agents'}
        </a>
        {' · '}
        <a class="underline decoration-line hover:text-accent" href={withBase(`/api/concept/${concept.conceptType}/${concept.id}.json`)}>
          JSON
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
