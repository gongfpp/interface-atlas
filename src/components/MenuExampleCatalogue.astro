---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MenuExampleDemo from '@/islands/MenuExampleDemo';
import MenuExamplePagination from '@/components/MenuExamplePagination.astro';
import { MENU_EXAMPLES, MENU_PAGE_COUNT, MENU_PAGE_SIZE, menuExamplePath } from '@/lib/menu-examples';
import { localePath, withBase, type Locale } from '@/lib/i18n';
interface Props { page:number; locale:Locale }
const {page,locale}=Astro.props;
const zh=locale==='zh';
const start=(page-1)*MENU_PAGE_SIZE;
const examples=MENU_EXAMPLES.slice(start,start+MENU_PAGE_SIZE);
const sheets=[0,1,2,3,5,6,7,8];
const title=zh?'菜单 / 下拉框':'Menus & Dropdowns';
---
<BaseLayout title={`${title} · ${page} / ${MENU_PAGE_COUNT} · ${zh?'界面图谱':'Interface Atlas'}`} description={zh?'40 种可操作的菜单与下拉框，每行一个案例，每页 10 个。':'40 interactive menu and dropdown patterns. One per row, ten per page.'} locale={locale} enPath={menuExamplePath(page)}>
 <section class="pt-12 pb-3">
  <a href={localePath('/components',locale)} class="text-sm text-ink-3 hover:text-accent">← {zh?'组件':'Components'}</a>
  <h1 class="mt-5 font-serif text-4xl font-semibold">{title}</h1>
  <p class="mt-3 text-sm leading-relaxed text-ink-2">{zh?'40 种菜单交互，选择、搜索、切换或拖动，直接查看结果。':'40 menu interactions. Select, search, switch or drag to see the result.'}</p>
  <details class="mc-originals mt-4"><summary>{zh?'设计原图':'Design originals'} <span aria-hidden="true">↗</span></summary><div id="menu-design-originals" class="mc-original-grid">{sheets.map((sheet,i)=><a href={withBase(`/images/gallery/menu-dropdown/${sheet}.webp`)} target="_blank" rel="noreferrer"><img src={withBase(`/images/gallery/menu-dropdown/${sheet}.webp`)} width="1536" height="2048" loading="lazy" decoding="async" alt={zh?`菜单设计原图 · 案例 ${i*5+1}–${i*5+5}`:`Menu design original · examples ${i*5+1}–${i*5+5}`}/><span>{MENU_EXAMPLES[i*5].en} — {MENU_EXAMPLES[i*5+4].en}</span></a>)}</div></details>
 </section>
 <MenuExamplePagination page={page} locale={locale} position="top"/>
 <div class="mc-catalogue py-2" data-menu-page={page}>
  {examples.map((example,i)=><article class="mc-row" id={example.id} data-menu-id={example.id}><div class="mc-meta"><div class="mc-heading"><span class="mc-number">{String(start+i+1).padStart(2,'0')}</span><div><h2><a href={`#${example.id}`}>{example[locale]}</a></h2>{zh&&<p class="mc-en">{example.en}</p>}</div></div><p class="mc-description" id={`${example.id}-description`}>{example.description[locale]}</p></div><MenuExampleDemo example={example} locale={locale} client:load/></article>)}
 </div>
 <div class="mb-12"><MenuExamplePagination page={page} locale={locale} position="bottom"/></div>
</BaseLayout>
<style>
.mc-originals summary{width:fit-content;cursor:pointer;color:var(--color-ink-secondary);font-size:13px}.mc-originals summary:hover{color:var(--color-accent)}.mc-originals summary:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}.mc-original-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-block:20px}.mc-original-grid img{width:100%;height:auto;border:1px solid var(--color-line);border-radius:8px}.mc-original-grid span{display:block;font-size:12px;line-height:1.5;margin-top:8px;color:var(--color-ink-secondary)}.mc-original-grid a:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}@media(max-width:700px){.mc-original-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
