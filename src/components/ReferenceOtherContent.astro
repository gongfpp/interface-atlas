---
import type { Locale } from '@/lib/i18n';
interface Props { slug:string; locale:Locale; nav:string[]; brand:string; }
const {slug,locale,nav,brand}=Astro.props;
const l=(zh:string,en:string)=>locale==='zh'?zh:en;
const commerce=['minimalism','skeuomorphism'].includes(slug);
const products=slug==='minimalism'?[l('Lumo 专注器','Lumo Focus'),l('桌面底座','Desk dock'),l('亚麻收纳袋','Linen sleeve')]:[l('经典胶片相机','Classic film camera'),l('手工皮革肩带','Handmade leather strap'),l('橡木相框','Oak photo frame')];
const prices=slug==='minimalism'?[699,129,89]:[1280,260,180];
const tasks=[l('整理本周计划','Plan the week'),l('完成首页原型','Finish homepage prototype'),l('阅读二十分钟','Read for twenty minutes'),l('给植物浇水','Water the plants'),l('傍晚散步','Take an evening walk')];
const close=l('关闭并返回','Close and return');
---
<div class:list={['other-content',`other-${slug}`]}>
{commerce && <>
  <section id="scene-section-0" class="other-section" tabindex="-1"><small>{brand} / 01</small><h2>{l('为日常挑选好物','Objects for everyday life')}</h2><p>{l('真实材质、耐用设计。选择一件物品，查看规格并加入本地演示购物袋。','Honest materials, lasting design. Explore an object and add it to the local demo bag.')}</p><div class="other-cards" data-product-list>{products.map((name,i)=><article data-product-name={name.toLowerCase()}><span class={`object-art object-${i}`} aria-hidden="true">{slug==='minimalism'?['◉','▱','▧'][i]:['▣','⌁','▤'][i]}</span><h3>{name}</h3><p>¥{prices[i]}</p><button type="button" data-scene-action={`goods-detail-${i}`}>{l('查看规格','View details')} →</button></article>)}</div><button type="button" data-scene-action="goods-bag">{l('查看购物袋','View shopping bag')} (<span data-bag-count>0</span>)</button></section>
  <section id="scene-section-1" class="other-section" tabindex="-1"><h2>{nav[1]}</h2><h3>{l('少一点消耗，多一点陪伴','Less consumption. More companionship.')}</h3><p>{slug==='minimalism'?l('早晨，把手机放远。Lumo 用实体旋钮选择 25 分钟专注时间，不推送消息，不打断思路。工作结束后，柔和的光会提醒你休息。','Put the phone away. Select a 25-minute focus session with a physical dial. No notifications, no interruptions. A soft light marks time to rest.'):l('从一卷胶片开始，记录不必完美的生活。我们与独立工坊一起修复经典相机，让耐用的金属与皮革继续被使用。','Start with a roll of film and record an imperfect life. We work with independent workshops to restore classic cameras and keep metal and leather in use.')}</p></section>
  <section id="scene-section-2" class="other-section" tabindex="-1"><h2>{nav[2]}</h2><details><summary>{l('材料与维护指南','Materials and care guide')}</summary><p>{l('避免长时间潮湿与暴晒。用柔软干布清洁表面，收纳前保持干燥。所有可更换零件均提供独立维护说明。','Avoid prolonged moisture and direct sunlight. Clean with a soft dry cloth. Store dry. Replaceable parts include individual care instructions.')}</p></details><details><summary>{l('维修而非替换','Repair, not replace')}</summary><p>{l('螺丝固定结构方便维护。我们优先选用可修复的标准零件，减少一次性使用。','Screw-fastened construction makes maintenance easier. Repairable standard components reduce waste.')}</p></details></section>
  <section id="scene-section-3" class="other-section" tabindex="-1"><h2>{nav[3]}</h2><p>{l('上海 · 永康路 38 号体验空间。周二至周日 11:00–19:00。此为设计样张中的虚构门店。','Shanghai · 38 Yongkang Road. Tuesday–Sunday, 11:00–19:00. Fictional store for this design study.')}</p><button type="button" data-scene-action="goods-search">{l('搜索产品目录','Search the collection')}</button></section>
  <dialog class="scene-dialog other-dialog" data-other-dialog="product" aria-labelledby="other-product-title"><button type="button" data-other-close>{close} ×</button><small>{brand} / OBJECT</small><h2 id="other-product-title" data-product-title></h2><p data-product-description></p><p data-product-price></p><label>{l('款式','Finish')}<select data-product-finish><option>{l('经典原色','Natural finish')}</option><option>{l('深灰色','Charcoal')}</option></select></label><button type="button" data-scene-action="goods-add">{l('加入购物袋','Add to bag')}</button><p role="status" data-product-status></p><button type="button" data-scene-action="goods-bag">{l('打开购物袋','Open bag')} →</button></dialog>
  <dialog class="scene-dialog other-dialog" data-other-dialog="bag" aria-labelledby="other-bag-title"><button type="button" data-other-close>{close} ×</button><h2 id="other-bag-title">{l('你的购物袋','Your shopping bag')}</h2><div data-bag-items></div><strong data-bag-total></strong><button type="button" data-scene-action="goods-checkout">{l('生成订单预览','Preview order')}</button><p role="status" data-order-preview></p><small>{l('本地演示，不收费、不收集支付信息。','Local demo. No charges or payment details.')}</small></dialog>
  <dialog class="scene-dialog other-dialog" data-other-dialog="goods-search" aria-label={l('搜索产品','Search objects')}><button type="button" data-other-close>{close} ×</button><label>{l('名称搜索','Search by name')}<input type="search" data-goods-query /></label><div data-goods-results>{products.map((name,i)=><button type="button" data-scene-action={`goods-detail-${i}`}>{name} · ¥{prices[i]}</button>)}</div><p role="status" data-goods-search-status></p></dialog>
</>}
{slug==='glassmorphism' && <>
  <section id="scene-section-0" class="other-section aurora-workspace" tabindex="-1">
    <header class="aurora-workspace-heading"><small>AURORA / WORKSPACE</small><h2>{l('把一个想法，写成第一稿','Turn an idea into a first draft')}</h2><p>{l('本地创意工作台：用固定创作模板整理你的灵感。这里不连接 AI 或云端服务。','A local creative workspace using fixed writing templates. No AI or cloud service is connected.')}</p></header>
    <div class="aurora-studio-grid">
      <form data-other-form="aurora" class="aurora-composer"><span class="aurora-panel-index">01 / {l('灵感起点','THE SPARK')}</span><label>{l('创作主题','Creative topic')}<input name="topic" required maxlength="100" value={l('雨后的城市散步','A city walk after rain')} /></label><label>{l('表达风格','Tone')}<select name="tone"><option value="poetic">{l('诗意','Poetic')}</option><option value="clear">{l('简洁','Clear')}</option></select></label><button type="submit">✧ {l('生成创作草稿','Generate draft')}</button></form>
      <div class="aurora-draft-panel"><span class="aurora-panel-index">02 / {l('让想法流动','LET IT FLOW')}</span><label>{l('可编辑的创作稿','Editable draft')}<textarea rows="7" data-aurora-draft placeholder={l('生成后可在这里继续编辑','Generate a draft, then make it yours')}></textarea></label><div class="other-actions"><button type="button" data-scene-action="aurora-save">{l('保存页面快照','Save page snapshot')}</button><button type="button" data-scene-action="aurora-restore" disabled>{l('恢复快照','Restore snapshot')}</button><button type="button" data-scene-action="aurora-export">{l('导出 .txt','Export .txt')}</button></div><p role="status" data-aurora-status></p></div>
    </div>
  </section>
  <section id="scene-section-1" class="other-section" tabindex="-1"><h2>{nav[1]}</h2><p>{l('写作：从一句主题生成结构。提案：整理目标、受众与行动。复盘：把零散笔记归纳为下一步。你始终可以编辑每一段文字。','Writing: build structure from a topic. Proposals: clarify goals, audience and action. Reflection: turn scattered notes into next steps. Every paragraph remains editable.')}</p></section>
  <section id="scene-section-2" class="other-section" tabindex="-1"><h2>{nav[2]}</h2><div class="other-cards">{[l('清晨的第一束光','First light of the morning'),l('一座城市的声音','The sounds of a city'),l('给未来自己的信','A letter to your future self')].map((t,i)=><button type="button" data-scene-action={`aurora-prompt-${i}`}>{t} ↗</button>)}</div></section>
  <section id="scene-section-3" class="other-section" tabindex="-1"><h2>{nav[3]}</h2><p>{l('Aurora 相信创作工具应该放大人的声音。本样张的草稿仅保存在当前浏览器，不会上传；导出文件由设备直接生成。','Aurora believes tools should amplify your voice. Drafts stay in this browser and are never uploaded. Exports are generated on your device.')}</p></section>
  <dialog class="scene-dialog other-dialog" data-other-dialog="aurora-feature" aria-labelledby="aurora-feature-title"><button type="button" data-other-close>{close} ×</button><small class="aurora-panel-index">✧ AURORA / CREATIVE TOOLS</small><h2 id="aurora-feature-title" data-feature-title></h2><p data-feature-copy></p><button type="button" data-scene-action="aurora-create">{l('进入创作台','Open workspace')} →</button></dialog>
</>}
{slug==='bento-grid' && <>
  <section id="scene-section-0" class="other-section" tabindex="-1"><small>TASKO / TODAY</small><h2>{l('今天，做好一件事','One thing at a time')}</h2><p data-tasko-selected>{l('2024 年 4 月 15 日 · 今日计划','15 April 2024 · Daily plan')}</p><div class="task-list">{tasks.map((t,i)=><label><input type="checkbox" data-task-check={i} /> <span>{t}</span></label>)}</div><form data-other-form="task"><label>{l('添加任务','Add a task')}<input name="task" required maxlength="100" /></label><button type="submit">+ {l('加入今日计划','Add to today')}</button></form><p role="status" data-task-status></p></section>
  <section id="scene-section-1" class="other-section" tabindex="-1"><h2>{l('日程与笔记','Schedule and notes')}</h2><p>{l('09:30 首页原型评审 · 14:00 安静创作 · 17:30 散步','09:30 Homepage review · 14:00 Quiet work · 17:30 Walk')}</p><form data-other-form="note"><label>{l('随手记录','Capture a thought')}<textarea name="note" rows="3" required maxlength="1000"></textarea></label><button type="submit">{l('保存笔记','Save note')}</button></form><ul data-tasko-notes><li>{l('让今天的计划留一点空白。','Leave a little space in today’s plan.')}</li></ul><p role="status" data-note-status></p></section>
  <section id="scene-section-2" class="other-section" tabindex="-1"><h2>{nav[2]}</h2><p>{l('周一整理目标，周三检查进度，周五留下一条复盘。把大项目拆成今天就能完成的小步骤。','Set goals Monday, review progress Wednesday, reflect Friday. Break a large project into one small step you can finish today.')}</p></section>
  <section id="scene-section-3" class="other-section" tabindex="-1"><h2>{nav[3]}</h2><p>{l('Tasko 是一个本地演示工作台。任务、笔记与日历在当前页面内联动，不会创建远程账号。','Tasko is a local demo workspace. Tasks, notes and the calendar work together within this page. No remote account is created.')}</p></section>
</>}
{slug==='neumorphism' && <>
  <section id="scene-section-0" class="other-section" tabindex="-1"><small>MELLOW / FOCUS</small><h2>{l('给自己一段安静的时间','Make a little quiet time')}</h2><p>{l('选择时长，开始专注。暂停可保留剩余时间，重置回到所选时长。','Choose a duration and begin. Pause keeps the time remaining; reset returns to your chosen duration.')}</p><label>{l('专注时长','Focus duration')}<select data-mellow-duration><option value="25">{l('25 分钟','25 minutes')}</option><option value="5">{l('5 分钟','5 minutes')}</option><option value="1">{l('1 分钟体验','1-minute trial')}</option></select></label><output class="focus-display" data-focus-time aria-live="off">25:00</output><div class="other-actions"><button type="button" data-scene-action="mellow-toggle">{l('开始专注','Start focus')}</button><button type="button" data-scene-action="mellow-reset">{l('重置','Reset')}</button></div><p role="status" data-focus-status>{l('准备好时再开始。','Begin when you are ready.')}</p></section>
  <section id="scene-section-1" class="other-section" tabindex="-1"><h2>{l('专注任务','Focus tasks')}</h2><div class="task-list">{[l('清理桌面','Clear your desk'),l('关闭无关通知','Silence notifications'),l('写下最重要的一件事','Write your most important task')].map(t=><label><input type="checkbox" /> <span>{t}</span></label>)}</div></section>
  <section id="scene-section-2" class="other-section" tabindex="-1"><h2>{l('专注统计','Focus statistics')}</h2><p><strong data-focus-sessions>0</strong> {l('个完整专注时段','completed sessions')}</p><p data-focus-minutes>{l('本次页面累计专注 0 分钟','0 focused minutes this visit')}</p><p>{l('统计仅计算实际运行时间；暂停与离开页面不会虚增时长。','Statistics count actual running time. Pauses do not add time.')}</p></section>
  <section id="scene-section-3" class="other-section" tabindex="-1"><h2>{l('你的安静空间','Your quiet space')}</h2><label>{l('使用昵称（仅当前页面）','Nickname (this page only)')}<input data-mellow-name maxlength="40" /></label><label class="inline-check"><input type="checkbox" data-mellow-contrast /> {l('提高工作台对比度','Higher workspace contrast')}</label><p role="status" data-mellow-profile></p></section>
</>}
{slug==='brutalism' && <>
  <section id="scene-section-0" class="other-section" tabindex="-1"><small>STUDIO VOID / SELECTED WORK</small><h2>NO BOUNDARIES.</h2><div class="other-cards">{['OPEN CITY / Identity','COMMON GROUND / Digital','RAW MATERIAL / Culture'].map((name,i)=><button type="button" class="void-case" data-scene-action={`void-case-${i}`}><strong>0{i+1}</strong><h3>{name}</h3><span>2024 ↗</span></button>)}</div></section>
  <section id="scene-section-1" class="other-section" tabindex="-1"><h2>{l('独立，不孤立。','Independent. Not isolated.')}</h2><p>{l('我们是由设计师、开发者和文化研究者组成的独立团队。通过直接的视觉语言，让复杂的问题变得清晰。','An independent team of designers, developers and cultural researchers. Direct visual language makes complex questions clear.')}</p></section>
  <section id="scene-section-2" class="other-section" tabindex="-1"><h2>NEWS / 2024</h2><details><summary>{l('开放城市：公共空间中的字体实验','Open City: typography in public space')}</summary><p>{l('我们在街道标识与数字地图之间建立统一字体系统。项目记录了行人如何识别方向，以及文字如何与建筑共同工作。','A shared type system connects street signage with digital maps. The project documents wayfinding and how lettering works with architecture.')}</p></details><details><summary>{l('工作室开放日：材料与屏幕','Open studio: materials and screens')}</summary><p>{l('从纸张印刷到交互原型，展示一次品牌如何在不同媒介中保持同样直接的声音。','From printed paper to interactive prototypes: how a brand keeps a direct voice across media.')}</p></details></section>
  <section id="scene-section-3" class="other-section" tabindex="-1"><h2>{l('开始对话。','START A CONVERSATION.')}</h2><form data-other-form="void-contact"><label>{l('你的名字','Your name')}<input name="name" required maxlength="80" autocomplete="name" /></label><label>{l('邮箱','Email')}<input name="email" type="email" required autocomplete="email" /></label><label>{l('项目方向','Project direction')}<textarea name="brief" required rows="4" maxlength="2000"></textarea></label><button type="submit">{l('整理联系提案','Prepare inquiry')} →</button><p role="status" data-contact-summary></p><small>{l('本地提案预览，不会发送邮件。','Local inquiry preview. No email is sent.')}</small></form></section>
  <dialog class="scene-dialog other-dialog" data-other-dialog="void-case" aria-labelledby="void-case-title"><button type="button" data-other-close>{close} ×</button><small>STUDIO VOID / CASE STUDY</small><h2 id="void-case-title" data-void-title></h2><p data-void-copy></p><h3>{l('交付内容','Deliverables')}</h3><p data-void-deliverables></p><button type="button" data-scene-action="nav-3">{l('讨论类似项目','Discuss a similar project')} →</button></dialog>
</>}
{slug==='neobrutalism' && <>
  <section id="scene-section-0" class="other-section" tabindex="-1"><small>PLAYLAB / WORK</small><h2>{l('认真做点有趣的事。','Seriously playful work.')}</h2><div class="other-cards">{[l('MOMO · 让城市骑行更轻松','MOMO · Easier city cycling'),l('Little Planet · 儿童探索实验室','Little Planet · A lab for young explorers'),l('Good Food · 社区餐桌计划','Good Food · A community table')].map((t,i)=><button type="button" data-scene-action={`play-work-${i}`}><span class="play-poster" data-play-poster={i} aria-hidden="true"><i></i><b>{['MOMO','LITTLE PLANET','GOOD FOOD'][i]}</b><em>0{i+1} / PLAYLAB</em></span><h3>{t}</h3><span>{l('查看创作过程','See the process')} ↗</span></button>)}</div></section>
  <section id="scene-section-1" class="other-section" tabindex="-1"><h2>{nav[1]}</h2><p>{l('从品牌策略、视觉设计到网站开发，我们和你共同完成每个小步骤。点击首屏清单，可以随时调整你需要的服务。','Brand strategy, visual design and web development, one small step together. Toggle the hero checklist to select the services you need.')}</p><p data-play-services>Design · Develop · Create</p><button type="button" data-scene-action="play-brief">{l('带着这些服务开始项目','Start with these services')} ↗</button></section>
  <section id="scene-section-2" class="other-section" tabindex="-1"><h2>{nav[2]}</h2><p>{l('PlayLab 是一个相信好奇心的设计小队。我们用开放协作、原型测试与一点幽默，让每个数字项目更有人情味。','PlayLab is a small design team driven by curiosity. Open collaboration, prototype testing and a little humor make digital projects more human.')}</p></section>
  <dialog class="scene-dialog other-dialog" data-other-dialog="play-brief" aria-labelledby="play-brief-title"><button type="button" data-other-close>{close} ×</button><small class="play-dialog-kicker">PLAYLAB / MAKE SOMETHING GOOD ↗</small><h2 id="play-brief-title">{l('一起创造！','Let’s make it!')}</h2><form data-other-form="play-brief"><label>{l('项目名称','Project name')}<input name="name" required maxlength="100" /></label><label>{l('希望改变什么？','What would you like to change?')}<textarea name="goal" required rows="4" maxlength="1500"></textarea></label><label>{l('预计时间','Timeline')}<select name="timeline"><option>{l('4–6 周','4–6 weeks')}</option><option>{l('2–3 个月','2–3 months')}</option><option>{l('先一起聊聊','Let’s discuss')}</option></select></label><p data-play-brief-services></p><button type="submit">{l('生成项目简报','Create project brief')} →</button></form><div data-play-summary role="status"></div><small>{l('仅生成本地简报，不会提交到服务器。','Generates a local brief. Nothing is sent to a server.')}</small></dialog>
  <dialog class="scene-dialog other-dialog" data-other-dialog="play-work" aria-labelledby="play-work-title"><button type="button" data-other-close>{close} ×</button><small class="play-dialog-kicker">PLAYLAB / FROM IDEA TO PLAY</small><h2 id="play-work-title" data-play-title></h2><div class="play-poster play-case-poster" data-play-poster="0" aria-hidden="true"><i></i><b data-play-mark>MOMO</b><em>PLAYLAB / SELECTED WORK</em></div><p data-play-copy></p><ol><li>{l('一起理解使用者与目标','Understand the people and goal')}</li><li>{l('把概念做成可点击原型','Build a clickable concept')}</li><li>{l('在真实使用中改进细节','Refine through real use')}</li></ol><button type="button" data-scene-action="play-brief">{l('开始我们的合作','Start our collaboration')} ↗</button></dialog>
</>}
{slug==='retro-web' && <>
  <section class="other-section retro-reading" tabindex="-1" data-retro-reading hidden><h2 data-retro-heading></h2><div data-retro-body></div><form data-other-form="guestbook" hidden><label>{l('昵称','Nickname')}<input name="name" required maxlength="40" /></label><label>{l('你的留言','Your message')}<textarea name="message" required maxlength="500" rows="3"></textarea></label><button type="submit">✉ {l('签写留言簿','Sign guestbook')}</button><p role="status" data-guest-status></p></form><ul data-guest-messages aria-label={l('演示留言','Demo messages')} hidden></ul></section>
  <dialog class="scene-dialog other-dialog" data-other-dialog="retro-address" aria-label={l('打开站内地址','Open an internal address')}><button type="button" data-other-close>{close} ×</button><form data-other-form="retro-address"><label>{l('站内地址','Internal address')}<input name="address" required maxlength="80" data-retro-route /></label><p>home / about / projects / links / guestbook</p><button type="submit">↵ Go</button><p role="status" data-retro-route-status></p></form></dialog>
  <dialog class="scene-dialog other-dialog" data-other-dialog="retro-menu" aria-labelledby="retro-menu-title"><button type="button" data-other-close>{close} ×</button><h2 id="retro-menu-title" data-retro-menu-title></h2><div data-retro-menu-items></div></dialog>
  <dialog class="scene-dialog other-dialog" data-other-dialog="retro-search" aria-label={l('站内搜索','Site search')}><button type="button" data-other-close>{close} ×</button><label>{l('查找站内页面','Find a page')}<input type="search" data-retro-query /></label><div data-retro-results>{['Home','About','Projects','Links','Guestbook'].map((t,i)=><button type="button" data-scene-action={`retro-page-${i}`}>{t}</button>)}</div><p role="status" data-retro-search-status></p></dialog>
  <dialog class="scene-dialog other-dialog" data-other-dialog="retro-favorites" aria-labelledby="retro-favorites-title"><button type="button" data-other-close>{close} ×</button><h2 id="retro-favorites-title">☆ Favorites</h2><button type="button" data-scene-action="retro-save">{l('收藏当前页面','Bookmark this page')}</button><div data-retro-bookmarks></div><p role="status" data-retro-favorite-status></p></dialog>
</>}
