---
import { localizeStylePreview, REFERENCE_STYLE_SLUGS, type StyleThumbSpec } from '@/lib/style-previews';
import ReferenceStyleScene from '@/components/ReferenceStyleScene.astro';
import SceneAction from '@/components/SceneAction.astro';
import GenericStyleContent from '@/components/GenericStyleContent.astro';
import StyleSignatureArt from '@/components/StyleSignatureArt.astro';
import '@/styles/generic-style-pages.css';
import '@/styles/style-signatures.css';
import type { Locale } from '@/lib/i18n';
import { getTeamSceneData, getTeamCalendarDays, teamDate, teamMonthLabel, TEAM_INITIAL_DATE, TEAM_INITIAL_YEAR, TEAM_INITIAL_MONTH } from '@/lib/team-scene-data';

interface Props {
  spec: StyleThumbSpec;
  /** 缩略模式更紧凑（首页墙） */
  compact?: boolean;
  locale?: Locale;
  interactive?: boolean;
}
const { spec: sourceSpec, compact = false, locale = 'zh', interactive = false } = Astro.props;
const spec = localizeStylePreview(sourceSpec, locale);
const referenceScene = REFERENCE_STYLE_SLUGS.includes(spec.slug);
const text = (zh: string, en: string) => locale === 'zh' ? zh : en;
const t = spec.tokens;
const titleStyle = `${t.upper ? 'text-transform:uppercase;' : ''}${t.italic ? 'font-style:italic;' : ''}letter-spacing:.01em;`;
const scale = compact ? 0.94 : 1;
const fs = (px: number) => `clamp(${(px * scale).toFixed(1)}px,${(px / 5.8).toFixed(2)}cqw,${(px * 2.2).toFixed(1)}px)`;
const pill = `background:${t.accent};color:${t.accentFg};border-radius:${t.radius === '0px' ? '2px' : '999px'};box-shadow:${t.shadow ?? 'none'};`;
const cardCss = `background:${t.card};border:1px solid ${t.cardBorder};border-radius:${t.radius};backdrop-filter:${t.blur ?? 'none'};`;
const ICONS = ['◆', '▲', '●'];
const team = getTeamSceneData(locale);
const teamDays = getTeamCalendarDays(TEAM_INITIAL_YEAR, TEAM_INITIAL_MONTH);
// 三色卡片有白、黄等浅色底，不能一律使用白字。
const inkOn = (background: string) => {
  let hex = background.replace('#', '');
  if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
  const rgb = [0,2,4].map(offset => parseInt(hex.slice(offset,offset+2),16) / 255).map(c => c <= 0.04045 ? c / 12.92 : ((c+0.055)/1.055) ** 2.4);
  const luminance = 0.2126*rgb[0]+0.7152*rgb[1]+0.0722*rgb[2];
  return luminance > 0.179 ? '#000000' : '#ffffff';
};
---

{referenceScene ? <ReferenceStyleScene slug={spec.slug} locale={locale} interactive={interactive} /> : (

<div data-style-scene={spec.slug} data-scene-locale={locale} data-generic-style data-scene-interactive={interactive ? 'true' : undefined} class="overflow-hidden border" style={`background:#fff;border-color:${t.cardBorder};border-radius:14px;box-shadow:0 2px 10px rgba(0,0,0,.09)`}>
  <!-- 浏览器 chrome -->
  <div class="flex items-center gap-1.5 border-b px-3 py-2" style={`background:${t.bg};border-color:${t.cardBorder}`}>
    <span class="h-2.5 w-2.5 rounded-full" style="background:#FF5F57"></span>
    <span class="h-2.5 w-2.5 rounded-full" style="background:#FEBC2E"></span>
    <span class="h-2.5 w-2.5 rounded-full" style="background:#28C840"></span>
    <span class="mx-auto flex w-1/2 items-center justify-center gap-1 truncate rounded-md px-3 py-1 text-[9px]" style={`background:${t.card};border:1px solid ${t.cardBorder};color:${t.sub};backdrop-filter:${t.blur ?? 'none'}`}>⌄ {spec.url}</span>
    <span class="w-10 text-right text-[10px]" style={`color:${t.sub}`}>⋮</span>
  </div>

  <div class="generic-style-hero relative overflow-hidden" style={`background:${t.bg};color:${t.fg};font-family:${t.font}`}>

    {spec.scene === 'paper' && (
      <div class={`p-4 ${compact ? '' : 'md:p-5'}`}>
        <div class="flex items-center gap-2">
          <span class="text-[11.5px] font-bold" style={titleStyle}>{spec.brand}</span>
          <span class="mx-auto flex gap-3.5">
            {spec.nav.map((n, i) => <SceneAction interactive={interactive} action={`nav-${i}`} data-generic-action={`nav-${i}`} class="hidden text-[9px] sm:inline" style={`color:${t.sub}`}>{n}</SceneAction>)}
          </span>
          <SceneAction interactive={interactive} action="search" data-generic-action="search" label={text('搜索笔记', 'Search notes')} class="text-[10px]" style={`color:${t.sub}`}>⌕</SceneAction>
        </div>
        <div class="mt-4 grid grid-cols-5 gap-4">
          <div class="col-span-2 flex flex-col justify-center">
            <p data-generic-title class="font-bold leading-[1.18]" style={`font-size:${fs(20)};${titleStyle}`}>{spec.heroTitle}<br/>{spec.heroTitle2}</p>
            <p class="mt-2.5 whitespace-pre-line text-[8.5px] leading-[1.8]" style={`color:${t.sub}`}>{spec.heroSub}</p>
            <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="mt-2.5 text-[9.5px] font-semibold" style={`color:${t.accent}`}>{spec.cta}</SceneAction>
          </div>
          <div data-generic-art class="col-span-2 relative overflow-hidden rounded-lg scribble-hero-art">
            <StyleSignatureArt slug="hand-drawn" locale={locale} />
            <p class="scribble-art-caption">{spec.heroCaption ?? text('生活不在别处，就在此刻。', 'Life is here, in this moment.')}</p>
          </div>
          <div class="col-span-1 flex flex-col justify-between gap-2">
            {spec.features!.map((f, i) => (
              <SceneAction interactive={false} action={`feature-${i}`} data-generic-action={`feature-${i}`} class="flex flex-1 items-start gap-1.5 border-b pb-1.5" style={`border-color:${t.cardBorder}`}>
                <span class="mt-0.5 h-6 w-7 shrink-0 rounded-sm" style="background:linear-gradient(150deg,#C9D5C2,#8FA487)"></span>
                <span>
                  <p class="text-[8px] font-semibold leading-tight">{f.t}</p>
                  <p class="text-[7px]" style={`color:${t.sub}`}>{f.s}</p>
                </span>
              </SceneAction>
            ))}
          </div>
        </div>
      </div>
    )}

    {spec.scene === 'aurora' && (
      <div class={`relative p-4 ${compact ? '' : 'md:p-5'}`} style={`min-height:${compact ? 170 : 200}px`}>
        <!-- 山景剪影 + 雾 -->
        <div class="absolute inset-x-0 bottom-0 h-2/3" style="background:linear-gradient(180deg,rgba(30,27,75,.0),rgba(30,27,75,.35));clip-path:polygon(0 100%,0 62%,18% 34%,34% 58%,52% 18%,70% 52%,86% 30%,100% 48%,100% 100%);opacity:.75"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/3" style="background:linear-gradient(180deg,transparent,rgba(255,255,255,.16))"></div>
        <div class="relative z-[1]">
          <div class="flex items-center gap-3">
            <span class="text-[11.5px] font-bold">{spec.brand}</span>
            <span class="mx-auto flex gap-3">
              {spec.nav.map((n, i) => <SceneAction interactive={interactive} action={`nav-${i}`} data-generic-action={`nav-${i}`} class="hidden text-[9px] sm:inline" style="color:rgba(255,255,255,.8)">{n}</SceneAction>)}
            </span>
            <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="rounded-full px-3 py-1.5 text-[8.5px] font-semibold" style="background:rgba(255,255,255,.28);color:#fff;backdrop-filter:blur(8px)">{spec.cta.replace(/\s*→$/, '')}</SceneAction>
          </div>
          <div class="mt-4 grid grid-cols-2 items-center gap-4">
            <div>
              <p data-generic-title class="font-bold leading-[1.2] text-white" style={`font-size:${fs(25)};${titleStyle}text-shadow:0 2px 12px rgba(30,27,75,.35)`}>{spec.heroTitle}<br/>{spec.heroTitle2}</p>
              <p class="mt-2 whitespace-pre-line text-[9px] leading-[1.8]" style="color:rgba(255,255,255,.8)">{spec.heroSub}</p>
              <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="mt-3 inline-block rounded-full bg-white px-4 py-2 text-[9.5px] font-bold" style="color:#3B2E6E;box-shadow:0 6px 18px rgba(30,27,75,.35)">{spec.cta}</SceneAction>
            </div>
            <div class:list={["grid grid-cols-2 gap-2.5", {"lumen-hero-cards":spec.slug==='liquid-glass'}]}>
              {spec.features!.slice(0, 3).map((f, i) => (
                <SceneAction interactive={false} action={`feature-${i}`} data-generic-action={`feature-${i}`} class="rounded-2xl p-2.5" style={`background:${t.card};border:1px solid ${t.cardBorder};backdrop-filter:${t.blur};box-shadow:0 8px 20px rgba(30,27,75,.18)`}>
                  <span class="mb-1.5 flex h-4 w-4 items-center justify-center rounded-lg text-[8px]" style="background:rgba(255,255,255,.5);color:#3B2E6E">✦</span>
                  <p class="text-[8.5px] font-semibold text-white">{f.t}</p>
                  <p class="text-[6.5px]" style="color:rgba(255,255,255,.75)">{f.s}</p>
                </SceneAction>
              ))}
              <div class="rounded-2xl p-2.5" style={`background:${t.card};border:1px solid ${t.cardBorder};backdrop-filter:${t.blur};box-shadow:0 8px 20px rgba(30,27,75,.18)`}>
                <p class="text-[7.5px] font-semibold leading-snug text-white">{spec.heroCaption ?? text('好的创意值得被看见。', 'Great ideas deserve to be seen.')}</p>
                <svg viewBox="0 0 60 18" class="mt-1 w-full"><path d="M0 14 L10 10 L20 12 L30 6 L40 9 L50 3 L60 5" fill="none" stroke="rgba(255,255,255,.85)" stroke-width="1.5"/><circle cx="50" cy="3" r="1.6" fill="#fff"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {spec.scene === 'tasko' && (
      <div class={`p-3.5 ${compact ? '' : 'md:p-4'}`}>
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-bold">{spec.brand}</span>
          <span class="mx-auto flex gap-2.5">
            {spec.nav.map((n, i) => <SceneAction interactive={interactive} action={`nav-${i}`} data-generic-action={`nav-${i}`} class="hidden text-[8px] sm:inline" style={`color:${t.sub}`}>{n}</SceneAction>)}
          </span>
          <SceneAction interactive={interactive} action="login" data-generic-action="login" class="text-[8px]" style={`color:${t.sub}`}>{text('登录', 'Log in')}</SceneAction>
          <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="rounded-full px-2.5 py-1 text-[8px] font-semibold" style={`background:${t.fg};color:${t.bg}`}>{text('免费注册', 'Sign up free')}</SceneAction>
        </div>
        <div class="gs-tasko-grid mt-3 grid grid-cols-4 gap-2.5" style={`min-height:${compact ? 130 : 150}px`}>
          <div class="col-span-1 rounded-2xl p-3" style={cardCss}>
            <p data-generic-title class="text-[12px] font-bold leading-snug">{spec.heroTitle}<br/>{spec.heroTitle2}</p>
            <p class="mt-1.5 text-[7px] leading-relaxed" style={`color:${t.sub}`}>{spec.heroSub}</p>
            <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="mt-2 inline-block rounded-full px-2.5 py-1 text-[7.5px] font-semibold" style={`background:${t.accent};color:${t.accentFg}`}>{spec.cta}</SceneAction>
            <div class="mt-2.5 flex items-center">
              <span class="-mr-1 h-4 w-4 rounded-full border-2 border-white" style="background:#F59E0B"></span>
              <span class="-mr-1 h-4 w-4 rounded-full border-2 border-white" style="background:#34D399"></span>
              <span class="h-4 w-4 rounded-full border-2 border-white" style="background:#60A5FA"></span>
              <span class="ml-1.5 text-[6.5px] font-semibold" style={`color:${t.sub}`}>+12K {text('全世界用户的选择', 'users worldwide')}</span>
            </div>
          </div>
          <div data-team-calendar-date={TEAM_INITIAL_DATE} class="gs-team-calendar col-span-1 flex flex-col rounded-2xl p-3" style={`${cardCss}--team-accent:${t.accent};--team-sub:${t.sub};`}>
            <div class="gs-team-calendar-head text-[7.5px] font-bold" style={`color:${t.sub}`}>
              <SceneAction interactive={interactive} action="calendar-previous" class="gs-team-month-arrow" label={text('上个月', 'Previous month')}>◀</SceneAction>
              <span data-team-month aria-live="polite">{teamMonthLabel(TEAM_INITIAL_YEAR, TEAM_INITIAL_MONTH, locale)}</span>
              <SceneAction interactive={interactive} action="calendar-next" class="gs-team-month-arrow" label={text('下个月', 'Next month')}>▶</SceneAction>
            </div>
            <div class="gs-team-calendar-grid mt-1 grid grid-cols-7 gap-x-1 gap-y-0.5 text-center" role={interactive ? 'group' : undefined} aria-label={interactive ? text('选择团队日程日期', 'Choose a team calendar date') : undefined}>
              {teamDays.map((day, i) => <SceneAction interactive={interactive} action="calendar-day" class="gs-team-day text-[5px] leading-[1.6]" data-team-cell={i} data-team-day={day ?? undefined} data-team-selected={day === 17 ? 'true' : 'false'} disabled={interactive && day === null ? true : undefined} aria-hidden={day === null ? 'true' : undefined} aria-pressed={interactive && day !== null ? String(day === 17) : undefined} label={day === null ? undefined : `${text('选择', 'Select')} ${teamDate(TEAM_INITIAL_YEAR, TEAM_INITIAL_MONTH, day)}`}>{day ?? ''}</SceneAction>)}
            </div>
            <SceneAction interactive={interactive} action="team-tasks" data-generic-action="team-tasks" class="gs-team-entry mt-auto block w-full rounded-xl p-1.5" style={`background:${t.bg}`} label={text('查看团队待办任务', 'View pending team tasks')}>
              <span class="block text-[7.5px] font-bold">{text('任务', 'Tasks')} <span data-team-task-count style={`color:${t.accent}`}>{team.tasks.length}</span></span>
              <span data-team-task-caption class="block text-[6px]" style={`color:${t.sub}`}>{text('今日待完成', 'Due today')} ✓</span>
            </SceneAction>
          </div>
          <div class="col-span-1 flex flex-col rounded-2xl p-3" style="background:#E2F4E8;border-radius:16px">
            <p class="text-[7.5px] font-semibold" style="color:#3E7C5B">⏱ {text('专注时段', 'Focus time')}</p>
            <p class="mt-0.5 text-[14px] font-bold" style="color:#1F5C40">3h 24m</p>
            <span class="mt-0.5 w-max rounded-full px-1.5 py-0.5 text-[6px] font-bold" style="background:#34B37A;color:#fff">+40%</span>
            <div class="mt-auto flex h-10 items-end gap-1">
              {[40, 65, 45, 80, 55, 90, 70].map((h, i) => (
                <span class="flex-1 rounded-sm" style={`height:${h}%;background:${i === 5 ? '#34B37A' : '#B2E0C8'}`}></span>
              ))}
            </div>
          </div>
          <div class="col-span-1 grid grid-rows-2 gap-2.5">
            <SceneAction interactive={interactive} action="team-notes" data-generic-action="team-notes" class="gs-team-entry block w-full rounded-2xl p-2.5" style={cardCss} label={text('打开团队笔记', 'Open team notes')}>
              <span class="block text-[8.5px] font-bold">{text('笔记', 'Notes')} <span data-team-note-count style={`color:${t.accent}`}>{team.notes.length}</span></span>
              <span class="mt-1.5 block h-1.5 w-full rounded" style={`background:${t.sub};opacity:.2`}></span>
              <span class="mt-1 block h-1.5 w-2/3 rounded" style={`background:${t.sub};opacity:.2`}></span>
              <span class="mt-1.5 flex gap-1"><span class="h-2.5 w-2.5 rounded" style={`background:${t.accent};opacity:.35`}></span><span class="h-2.5 w-2.5 rounded" style={`background:${t.accent};opacity:.2`}></span></span>
            </SceneAction>
            <div class="relative overflow-hidden rounded-2xl p-2.5" style="background:linear-gradient(160deg,#B7CBE0,#7E9BB8 55%,#46648A)">
              <p class="text-[8.5px] font-bold leading-snug text-white">{text('小小的进步', 'Small steps')}<br/>{text('也是一种伟大', 'are great too')}</p>
              <p class="mt-0.5 text-[6.5px] text-white/85"><SceneAction interactive={interactive} action="team-tasks" data-generic-action="team-tasks" class="gs-team-keep">Keep going →</SceneAction></p>
              <span class="absolute -right-2 -top-2 h-8 w-8 rounded-full" style="background:rgba(255,255,255,.22)"></span>
            </div>
          </div>
        </div>
      </div>
    )}

    {spec.scene === 'generic' && (
      <div class={`p-4 ${compact ? '' : 'md:p-5'}`}>
        <div class="flex items-center gap-2.5">
          <span class="text-[10.5px] font-bold" style={titleStyle}>{spec.brand}</span>
          <span class="mx-auto flex gap-3">
            {spec.nav.map((n, i) => <SceneAction interactive={interactive} action={`nav-${i}`} data-generic-action={`nav-${i}`} class="hidden text-[9px] sm:inline" style={`color:${t.sub}`}>{n}</SceneAction>)}
          </span>
          {spec.navExt?.map((n, i) => ['flat-design', 'y2k'].includes(spec.slug)
            ? <SceneAction interactive={interactive} action={`extra-${i}`} data-generic-action={`extra-${i}`} class="hidden text-[8px] md:inline" style={`color:${t.sub}`}>{n}</SceneAction>
            : <span class="hidden text-[8px] md:inline" style={`color:${t.sub}`}>{n}</span>)}
          <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="rounded-full px-3 py-1.5 text-[8.5px] font-semibold" style={pill}>{spec.cta.replace(' →', '')}</SceneAction>
        </div>

        <div class="mt-4 grid grid-cols-5 items-center gap-4">
          <div class="col-span-2">
            <p data-generic-title class="font-bold leading-[1.1]" style={`font-size:${spec.slug === 'art-deco' ? 'clamp(0px,3.3cqw,42px)' : fs(Number((t.heroSize ?? '22px').replace('px', '')) + 4)};${titleStyle}`}>{spec.heroTitle}<br/>{spec.heroTitle2}</p>
            <p class="mt-2 text-[9.5px] leading-relaxed" style={`color:${t.sub}`}>{spec.heroSub}</p>
            {spec.heroCaption && <p class="mt-1.5 text-[7.5px] uppercase tracking-widest" style={`color:${t.sub};opacity:.85`}>{spec.heroCaption}</p>}
            <SceneAction interactive={interactive} action="primary" data-generic-action="primary" class="mt-3 inline-block rounded-full px-4 py-2 text-[9.5px] font-semibold" style={pill}>{spec.cta.replace(/\s*→$/, '')} →</SceneAction>
          </div>

          <!-- 右侧视觉面板 -->
          <div data-generic-art data-art-panel={spec.panel} class="col-span-3 relative flex h-[120px] items-center justify-center overflow-hidden" style={`background:${t.card};border:1px solid ${t.cardBorder};border-radius:${t.radius};backdrop-filter:${t.blur ?? 'none'};box-shadow:${t.shadow ?? 'none'}`}>
            {['art-deco','cyberpunk','organic','bauhaus','retro-futurism'].includes(spec.slug) && <StyleSignatureArt slug={spec.slug} locale={locale} />}
            {spec.panel === 'shapes' && !['art-deco','bauhaus'].includes(spec.slug) && (() => {
              const c = t.triCards ?? [t.accent, t.accent, t.accent];
              return (
                <div class="relative flex items-center gap-4">
                  <span class="h-12 w-12 rounded-full" style={`background:${c[0]};box-shadow:0 8px 16px rgba(0,0,0,.12)`}></span>
                  <span class="h-0 w-0" style={`border-left:17px solid transparent;border-right:17px solid transparent;border-bottom:30px solid ${c[1]};filter:drop-shadow(0 6px 8px rgba(0,0,0,.12))`}></span>
                  <span class="h-9 w-14 rotate-3" style={`background:${c[2]};border-radius:${t.radius};box-shadow:0 8px 16px rgba(0,0,0,.12)`}></span>
                  <span class="absolute -left-5 -top-4 h-2 w-2 rounded-full" style={`background:${c[0]};opacity:.6`}></span>
                  <span class="absolute -bottom-3 right-2 h-1.5 w-1.5 rounded-full" style={`background:${c[2]};opacity:.6`}></span>
                </div>
              );
            })()}
            {spec.panel === 'device' && (
              <div class="relative">
                <div class="relative h-14 w-24 rounded-2xl" style={`background:linear-gradient(150deg,#fff 25%,color-mix(in srgb,${t.accent} 18%,#fff) 100%);box-shadow:0 12px 22px rgba(0,0,0,.16), inset 0 1px 0 rgba(255,255,255,.95);border:1px solid ${t.cardBorder}`}>
                  <span class="absolute right-2.5 top-2.5 h-2.5 w-2.5 rounded-full" style={`background:radial-gradient(circle at 35% 35%,#fff,${t.accent})`}></span>
                  <span class="absolute bottom-2.5 left-2.5 h-1.5 w-10 rounded" style={`background:${t.accent};opacity:.45`}></span>
                  <span class="absolute bottom-2.5 right-2.5 h-1.5 w-4 rounded" style={`background:${t.accent};opacity:.25`}></span>
                </div>
                <div class="mx-auto h-5 w-16" style={`background:linear-gradient(180deg,${t.accent}33,${t.accent}11);clip-path:polygon(10% 0,90% 0,100% 100%,0 100%)`}></div>
                <div class="mx-auto mt-0.5 h-1.5 w-20 rounded-full" style="background:radial-gradient(ellipse,rgba(0,0,0,.14),transparent 70%)"></div>
              </div>
            )}
            {spec.panel === 'screen' && (
              <div class="flex w-5/6 items-center gap-3.5 rounded-xl p-3.5" style="background:linear-gradient(180deg,#3B4754,#222D38);box-shadow:inset 0 2px 8px rgba(0,0,0,.55), 0 1px 0 rgba(255,255,255,.25)">
                <div class="flex-1">
                  <div class="h-2 w-full rounded" style="background:rgba(255,255,255,.4)"></div>
                  <div class="mt-1.5 h-2 w-2/3 rounded" style="background:rgba(255,255,255,.22)"></div>
                  <div class="mt-2 h-1.5 w-1/2 rounded" style={`background:${t.accent};box-shadow:0 0 8px ${t.accent}66`}></div>
                </div>
                <span class="h-8 w-8 rounded-full border-[3px]" style={`border-color:#5B6B7A;background:conic-gradient(${t.accent} 30%, #94A3B8 30% 100%);box-shadow:0 2px 6px rgba(0,0,0,.4)`}></span>
              </div>
            )}
            {spec.panel === 'chart' && !['cyberpunk','retro-futurism'].includes(spec.slug) && (() => {
              const bars = [35, 60, 45, 85, 55, 95, 70];
              return (
                <div class="w-5/6">
                  <div class="relative flex h-16 items-end gap-1.5" style={`border-bottom:2px solid color-mix(in srgb,${t.sub} 30%,transparent)`}>
                    {bars.map((h, i) => (
                      <span class="flex-1 rounded-t" style={`height:${h}%;background:${i === 5 ? t.accent : `color-mix(in srgb, ${t.accent} 32%, transparent)`};box-shadow:${i === 5 ? `0 0 12px ${t.accent}55` : 'none'}`}></span>
                    ))}
                  </div>
                  <div class="mt-1.5 flex justify-between text-[6px]" style={`color:${t.sub}`}><span>{text('周一', 'MON')}</span><span>{text('周三', 'WED')}</span><span>{text('周五', 'FRI')}</span><span>{text('周日', 'SUN')}</span></div>
                </div>
              );
            })()}
            {spec.panel === 'photo' && spec.slug !== 'organic' && (
              <div class="relative h-full w-full overflow-hidden" style="background:linear-gradient(180deg,#9DB6CE 0%,#D6C9A8 55%,#7E8B6E 100%)">
                <span class="absolute left-4 top-2.5 h-7 w-7 rounded-full" style="background:radial-gradient(circle,#FFF9E8 30%,#F0D9A0 100%);box-shadow:0 0 14px rgba(255,240,190,.95)"></span>
                <span class="absolute bottom-0 left-0 h-8 w-full" style="background:linear-gradient(180deg,transparent,rgba(50,60,42,.6))"></span>
                <span class="absolute bottom-2 left-4 h-6 w-11 rounded-sm" style="background:linear-gradient(160deg,#8A6B4F,#5E4632)"></span>
                <span class="absolute bottom-2 left-16 h-5 w-5 rounded-full" style="background:#E8E2D4"></span>
              </div>
            )}
            {spec.panel === 'mountain' && (
              <div class="relative h-full w-full">
                <span class="absolute inset-x-0 bottom-0 h-4/5" style="background:linear-gradient(180deg,rgba(13,15,30,.5),rgba(13,15,30,.85));clip-path:polygon(0 100%,0 55%,22% 20%,40% 60%,58% 8%,78% 50%,100% 30%,100% 100%)"></span>
                <span class="absolute right-5 top-2.5 h-4 w-4 rounded-full" style="background:radial-gradient(circle,#fff,rgba(255,255,255,.2));box-shadow:0 0 10px rgba(255,255,255,.8)"></span>
                <span class="absolute left-5 top-3 h-1 w-1 rounded-full bg-white"></span>
                <span class="absolute left-12 top-6 h-0.5 w-0.5 rounded-full bg-white/70"></span>
              </div>
            )}
          </div>
        </div>

        {spec.features && (
          <div class="mt-4 grid grid-cols-3 gap-3">
            {spec.features.map((f, i) => (
              <SceneAction interactive={false} action={`feature-${i}`} data-generic-action={`feature-${i}`} class="block w-full p-3" style={`background:${t.triCards ? t.triCards[i] : t.card};border:1px solid ${t.triCards ? 'transparent' : t.cardBorder};border-radius:${t.radius};backdrop-filter:${t.blur ?? 'none'};box-shadow:${t.shadow ?? 'none'};color:${t.triCards ? inkOn(t.triCards[i]) : 'inherit'}`}>
                <span class="mb-2 flex items-center gap-1.5">
                  <span class="flex h-4 w-4 items-center justify-center rounded-md text-[7px]" style={`background:${t.triCards ? 'rgba(255,255,255,.85)' : t.accent};color:${t.triCards ? '#111111' : t.accentFg}`}>{spec.slug === 'bauhaus' ? ['●','■','▲'][i] : ICONS[i]}</span>
                  <span class="text-[9.5px] font-bold" style={titleStyle}>{f.t}</span>
                </span>
                <p class="text-[8px]" style={`color:${t.triCards ? inkOn(t.triCards[i]) : t.sub}`}>{f.s}</p>
              </SceneAction>
            ))}
          </div>
        )}

        <div class="mt-3 flex items-center justify-between text-[7px]" style={`color:${t.sub}`}>
          <span>© 2024 {spec.brand}</span>
          <span class="flex gap-2"><span>◦</span><span>◦</span><span>◦</span></span>
        </div>
      </div>
    )}
  </div>
  {interactive && <GenericStyleContent spec={sourceSpec} locale={locale} />}
</div>

)}
